{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Create Images",
            "type": "shell",
            "command": "${workspaceFolder}/make.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem",
                "close": false,
                "focus": true
            },
            "problemMatcher": ["$brc"]
        },
        {
            "label": "Stop QEMU",
            "type": "shell",
            "command": "echo quit | nc -U /tmp/qemu-monitor.sock",
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem",
                "close": false,
                "focus": true
            }
        }
    ]
}