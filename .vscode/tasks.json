{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Create Images",
            "type": "shell",
            "command": "${workspaceFolder}/create_images.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem",
                "close": true,
                "focus": false
            }
        },
        {
            "label": "Stop in VirtualBox",
            "type": "shell",
            "command": "VBoxManage controlvm \"Bits Runner\" poweroff",
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem",
                "close": true,
                "focus": false
            }
        }
    ]
}