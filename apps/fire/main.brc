@import B
@import BR
@import Syscall

selectedModeInfo blob<@Syscall::Video::ModeInfo>
surfaceResourceId u32

heatWidth u32
heatHeight u32
p_heatMap ptr<data<u8>>

heat u8 <- 200

randNext u32
rand fun -> u32
    if randNext = 0: randNext <- @Syscall::System::getTimestamp()
    randNext <- randNext * 1103515245 + 12345
    ret (randNext / 65536) % 32768
;

@export start fun
    modesCount u32 <- @Syscall::Video::getModesCount()
    rep i u32, i < modesCount, i <- i + 1
        modeInfo blob<@Syscall::Video::ModeInfo> <- @Syscall::Video::getModeInfo(i)

        if (selectedModeInfo.width != 640 or selectedModeInfo.bpp < 16) and (modeInfo.bpp >= 16 or modeInfo.width = 640)
            selectedModeInfo <- modeInfo
        else if selectedModeInfo.id = 0
            selectedModeInfo <- modeInfo
        ;
    ;

    surfaceResourceId <- @Syscall::System::grabResource(@Syscall::System::ResourceCategory::VIDEO_GET_SURFACE, selectedModeInfo.id, 0)

    heatWidth <- selectedModeInfo.width
    heatHeight <- selectedModeInfo.height
    p_heatMap <- @BSys::memAlloc(u8.size * heatWidth * heatHeight).ptr<data<u8>>

    p_bitmap ptr<blob<@BR::Bitmap>>
    match @BR::Bitmap::new(selectedModeInfo.width, selectedModeInfo.height, 32)
        enum<@B::Result, ptr<blob<@BR::Bitmap>>>::Success: p_bitmap <- $0.val.ptr<blob<@BR::Bitmap>>
    ;

    rep
        rep x u32 <- 5, x < heatWidth - 5, x <- x + 1
            p_heatMap.val[(heatHeight - 1) * heatWidth + x] <- heat + (rand() % 16).u8
        ;

        rep y u32 <- 1, y < heatHeight - 1, y <- y + 1
            rep x u32 <- 1, x < heatWidth - 1, x <- x + 1
                value s32 <- p_heatMap.val[y * heatWidth + x].s32 +
                    p_heatMap.val[(y+1) * heatWidth + x].s32 +
                    p_heatMap.val[y * heatWidth + x + 1].s32 +
                    p_heatMap.val[y * heatWidth + x - 1].s32
                value <- value / 4
                if value > 15
                    value <- value + (rand() % 17).s32 - 8
                ;
                p_heatMap.val[y * heatWidth + x] <- value.u8
            ;
        ;

        whiteThreshold u32 <- 120
        yellowThreshold u32 <- 80

        rep y u32, y < heatHeight, y <- y + 1
            rep x u32, x < heatWidth, x <- x + 1
                value u32 <- p_heatMap.val[y * heatWidth + x]

                r u32
                g u32
                b u32

                if value > whiteThreshold
                    r <- 255
                    g <- 255
                    b <- (value - whiteThreshold) * 255 / (255 - whiteThreshold)
                else if value > yellowThreshold
                    r <- 255
                    g <- (value - yellowThreshold) * 255 / (whiteThreshold - yellowThreshold)
                    b <- 0
                else
                    r <- value * 255 / yellowThreshold
                    g <- 0
                    b <- 0
                ;

                p_bitmap.val.set(x, y, r.u8, g.u8, b.u8)
            ;
        ;

        @Syscall::Video::drawBitmap(surfaceResourceId, 0, 0, p_bitmap.val.width, p_bitmap.val.height, p_bitmap.val.bpp, p_bitmap.val.a_data)
        @Syscall::Video::commit(surfaceResourceId)
    ;
;