cmd_help fun
    @B::String("reboot: Reboots the system").println()
    @B::String("time: Shows current timestamp").println()
    @B::String("ls <PATH>: Shows file/dir info").println()
    @B::String("rm <PATH>: Delete file/dir").println()
    @B::String("read <PATH>: Read first 64 bytes").println()
    @B::String("write <PATH>: Write text to a file").println()
    @B::String("mem: Show memory info").println()
    @B::String("play: Plays a tune").println()
    @B::String("dcpu: Dumps current CPU state").println()
    @B::String("dpaging: Dumps paging tables").println()
    @B::String("dstack: Dumps stack contents").println()
    @B::String("dmem: Dumps memory contents").println()
    @B::String("help: This thing").println()
;

test fun
    @BSys::Allocator::FirstFit::instance.debugPrintFrames()
    @BSys::memAlloc(1024)
    @BSys::Allocator::FirstFit::instance.debugPrintFrames()
;