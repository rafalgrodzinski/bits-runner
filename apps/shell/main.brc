cmd_help fun
    @B::String("reboot: Reboots the system").println()
    @B::String("time: Shows current timestamp").println()
    @B::String("ls <PATH>: Shows file/dir info").println()
    @B::String("rm <PATH>: Delete file/dir").println()
    @B::String("mem: Show memory info").println()
    @B::String("play: Plays a tune").println()
    @B::String("help: This thing").println()
;