@import B
@import Syscall

@export start fun
    character u8 <- 0
    input blob<@B::String> <- @B::String("")
    cmd blob<@B::String> <- @B::String("")
    arg blob<@B::String> <- @B::String("")

    rep
        @B::String("> ").printColor(@B::String::FOREGROUND_GREEN | @B::String::ATTRIB_BRIGHT)

        rep character != '\n'
            character <- @Syscall::Input::getAscii().u8
            if character = '\b': input.removeLast()
            else if character != '\n' and character != '\0': input.append(character)

            if character != '\0'
                charString blob<@B::String> <- @B::StringForChar(character)
                charString.print()
            ;
        ;

        // split into cmd and arg
        loc u32 <- input.find(@B::String(" "))
        if loc > 0
            cmd <- input.subStringTo(loc)
            arg <- input.subStringFrom(loc + 1)
        else
            cmd <- input
        ;

        // System
        if cmd.isEqual(@B::String("reboot"))
            cmd_reboot()
        else if cmd.isEqual(@B::String("time"))
            cmd_time()
        // Mem
        else if cmd.isEqual(@B::String("mem"))
            cmd_mem()
        // Storage
        else if cmd.isEqual(@B::String("ls"))
            cmd_ls(arg)
        else if cmd.isEqual(@B::String("rm"))
            cmd_rm(arg)
        else if cmd.isEqual(@B::String("read"))
            cmd_read(arg)
        else if cmd.isEqual(@B::String("write"))
            cmd_write(arg)
        // Other
        else if cmd.isEqual(@B::String("play"))
            cmd_play()
        else if cmd.isEqual(@B::String("help"))
            cmd_help()
        else
            @B::String("Dunno").printlnColor(@B::String::FOREGROUND_RED)
        ;

        character <- '\0'
        input.clear()
    ;
;

// System
cmd_reboot fun
    @B::String("Rebooting...").println()
    @Syscall::System::reboot()
;

cmd_time fun
    timestamp u32 <- @Syscall::System::getTimestamp()
    @B::StringForU32(timestamp).println()
;

// Memory
cmd_mem fun
    info blob<@Syscall::InfoMem> <- @Syscall::Memory::getInfo()

    @B::String("Total size: ").print()
    @B::StringForU32(info.totalSize).println()

    @B::String("Total pages: ").print()
    @B::StringForU32(info.totalPages).println()

    @B::String("Unavailable pages: ").print()
    @B::StringForU32(info.unavailablePages).println()

    @B::String("Free pages: ").print()
    @B::StringForU32(info.freePages).println()

    @B::String("Kernel pages: ").print()
    @B::StringForU32(info.kernelPages).println()

    @B::String("Kernel stack pages: ").print()
    @B::StringForU32(info.kernelStackPages).println()

    @B::String("User pages: ").print()
    @B::StringForU32(info.userPages).println()

    @B::String("Heap start: ").print()
    @B::StringForU32(info.kernelHeapStart).println()

    @B::String("Heap size: ").print()
    @B::StringForU32(info.kernelHeapSize).println()

    @B::String("Allocated bytes: ").print()
    @B::StringForU32(info.kernelAllocateBytes).println()
;

// Storage
cmd_ls fun: path blob<@B::String>
    resourceId u32 <- @Syscall::System::grabResource(@Syscall::System::ResourceCategory::GET_STORAGE_ENTRY, path.adr.u32, 0)
    @B::StringForU32(resourceId).println()
    entryInfo blob<@Syscall::Storage::EntryInfo> <- @Syscall::Storage::getEntryInfo(resourceId)

    @B::String("Kind: ").print()
    @B::StringForU32(entryInfo.kind).println()

    @B::String("Size: ").print()
    @B::StringForU32(entryInfo.entrySize).println()
;

cmd_rm fun: path blob<@B::String>
    resourceId u32 <- @Syscall::System::grabResource(@Syscall::System::ResourceCategory::GET_STORAGE_ENTRY, path.adr.u32, 0)
    @B::StringForU32(resourceId).println()
    @Syscall::Storage::deleteEntry(resourceId)
;

cmd_read fun: path blob<@B::String>
    stringData blob<@B::String>
    resourceId u32 <- @Syscall::System::grabResource(@Syscall::System::ResourceCategory::GET_STORAGE_ENTRY, path.adr.u32, 0)
    @Syscall::Storage::readEntry(resourceId, 0, 64, stringData.string.adr)
    stringData.println()
;

cmd_write fun: path blob<@B::String>
    stringData blob<@B::String> <- @B::String("Bits runner test!\nWriting to a file.\n")
    resourceId u32 <- @Syscall::System::grabResource(@Syscall::System::ResourceCategory::CREATE_STORAGE_ENTRY, path.adr.u32, 0)
    if resourceId = 0: ret
    @Syscall::Storage::writeEntry(resourceId, 0, 64, stringData.string.adr)
;

