@import B
@import Syscall
@import BSys

@export start fun
    character u8 <- 0
    input blob<@B::String> <- @B::String("")
    cmd blob<@B::String> <- @B::String("")
    arg blob<@B::String> <- @B::String("")

    rep
        @B::String("> ").printColor(@B::String::FOREGROUND_GREEN | @B::String::ATTRIB_BRIGHT)

        rep character != '\n'
            character <- @Syscall::Input::getAscii().u8
            if character = '\b': input.removeLast()
            else if character != '\n' and character != '\0': input.append(character)

            if character != '\0'
                charString blob<@B::String> <- @B::StringForChar(character)
                charString.print()
            ;
        ;

        // split into cmd and arg
        loc u32 <- input.find(@B::String(" "))
        if loc > 0
            cmd <- input.subStringTo(loc)
            arg <- input.subStringFrom(loc + 1)
        else
            cmd <- input
        ;

        // System
        if cmd.isEqual(@B::String("reboot"))
            cmd_reboot()
        else if cmd.isEqual(@B::String("time"))
            cmd_time()
        // Mem
        else if cmd.isEqual(@B::String("mem"))
            cmd_mem()
        // Storage
        else if cmd.isEqual(@B::String("ls"))
            cmd_ls(arg)
        else if cmd.isEqual(@B::String("rm"))
            cmd_rm(arg)
        else if cmd.isEqual(@B::String("read"))
            cmd_read(arg)
        else if cmd.isEqual(@B::String("write"))
            cmd_write(arg)
        // Other
        else if cmd.isEqual(@B::String("play"))
            cmd_play()
        else if cmd.isEqual(@B::String("help"))
            cmd_help()
        // Debug
        else if cmd.isEqual(@B::String("dcpu"))
            @Syscall::Debug::dumpCpuState()
        else if cmd.isEqual(@B::String("dpaging"))
            @Syscall::Debug::dumpPaging()
        else if cmd.isEqual(@B::String("dstack"))
            @Syscall::Debug::dumpStack(80)
        else if cmd.isEqual(@B::String("dmem"))
            @Syscall::Debug::dumpMemory(0x40_0000, 256)
        else if cmd.isEqual(@B::String("test"))
            test()
        // Else
        else
            @B::String("Dunno").printlnColor(@B::String::FOREGROUND_RED)
        ;

        character <- '\0'
        input.clear()
    ;
;

// System
cmd_reboot fun
    @B::String("Rebooting...").println()
    @Syscall::System::reboot()
;

cmd_time fun
    timestamp u32 <- @Syscall::System::getTimestamp()
    @B::StringForU32(timestamp).println()
;

// Memory
cmd_mem fun
    info blob<@Syscall::Memory::Info> <- @Syscall::Memory::getInfo()

    @B::String("Total size: ").print()
    @B::StringForU32(info.totalSize).println()

    @B::String("Total pages count: ").printColor(@B::String::FOREGROUND_CYAN)
    @B::StringForU32(info.totalPagesCount).printlnColor(@B::String::FOREGROUND_CYAN)

    @B::String("Unavailable pages count: ").printColor(@B::String::FOREGROUND_CYAN)
    @B::StringForU32(info.unavailablePagesCount).printlnColor(@B::String::FOREGROUND_CYAN)

    @B::String("Free pages count: ").printColor(@B::String::FOREGROUND_CYAN)
    @B::StringForU32(info.freePagesCount).printlnColor(@B::String::FOREGROUND_CYAN)

    @B::String("Kernel pages count: ").printColor(@B::String::FOREGROUND_RED)
    @B::StringForU32(info.kernelPagesCount).printlnColor(@B::String::FOREGROUND_RED)

    @B::String("Kernel stack pages count: ").printColor(@B::String::FOREGROUND_RED)
    @B::StringForU32(info.kernelStackPagesCount).printlnColor(@B::String::FOREGROUND_RED)

    @B::String("Kernel heap address: ").printColor(@B::String::FOREGROUND_RED)
    @B::StringHexForU32(info.kernelHeapAdr.u32).printlnColor(@B::String::FOREGROUND_RED)

    @B::String("Kernel heap size: ").printColor(@B::String::FOREGROUND_RED)
    @B::StringForU32(info.kernelHeapSize).printlnColor(@B::String::FOREGROUND_RED)

    @B::String("Kernel heap used size: ").printColor(@B::String::FOREGROUND_RED)
    @B::StringForU32(info.kernelHeapUsedSize).printlnColor(@B::String::FOREGROUND_RED)
    
    @B::String("User pages count: ").printColor(@B::String::FOREGROUND_GREEN)
    @B::StringForU32(info.userPagesCount).printlnColor(@B::String::FOREGROUND_GREEN)

    @B::String("User stack pages count: ").printColor(@B::String::FOREGROUND_GREEN)
    @B::StringForU32(info.userStackPagesCount).printlnColor(@B::String::FOREGROUND_GREEN)

    @B::String("User heap address: ").printColor(@B::String::FOREGROUND_GREEN)
    @B::StringHexForU32(@BSys::Allocator::FirstFit::instance.getAdr().u32).printlnColor(@B::String::FOREGROUND_GREEN)

    @B::String("User heap size: ").printColor(@B::String::FOREGROUND_GREEN)
    @B::StringForU32(@BSys::Allocator::FirstFit::instance.getSize()).printlnColor(@B::String::FOREGROUND_GREEN)

    @B::String("User heap used size: ").printColor(@B::String::FOREGROUND_GREEN)
    @B::StringForU32(@BSys::Allocator::FirstFit::instance.getUsedSize()).printlnColor(@B::String::FOREGROUND_GREEN)
;

// Storage
cmd_ls fun: path blob<@B::String>
    resourceId u32 <- @Syscall::System::grabResource(@Syscall::System::ResourceCategory::GET_STORAGE_ENTRY, path.adr.u32, 0)
    @B::StringForU32(resourceId).println()
    entryInfo blob<@Syscall::Storage::EntryInfo> <- @Syscall::Storage::getEntryInfo(resourceId)

    @B::String("Kind: ").print()
    @B::StringForU32(entryInfo.kind).println()

    @B::String("Size: ").print()
    @B::StringForU32(entryInfo.entrySize).println()
;

cmd_rm fun: path blob<@B::String>
    resourceId u32 <- @Syscall::System::grabResource(@Syscall::System::ResourceCategory::GET_STORAGE_ENTRY, path.adr.u32, 0)
    @B::StringForU32(resourceId).println()
    @Syscall::Storage::deleteEntry(resourceId)
;

cmd_read fun: path blob<@B::String>
    stringData blob<@B::String>
    resourceId u32 <- @Syscall::System::grabResource(@Syscall::System::ResourceCategory::GET_STORAGE_ENTRY, path.adr.u32, 0)
    @Syscall::Storage::readEntry(resourceId, 0, 64, stringData.string.adr)
    stringData.println()
;

cmd_write fun: path blob<@B::String>
    stringData blob<@B::String> <- @B::String("Bits runner test!\nWriting to a file.\n")
    resourceId u32 <- @Syscall::System::grabResource(@Syscall::System::ResourceCategory::CREATE_STORAGE_ENTRY, path.adr.u32, 0)
    if resourceId = 0: ret
    @Syscall::Storage::writeEntry(resourceId, 0, 64, stringData.string.adr)
;

// Other
