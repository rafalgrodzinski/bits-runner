@module BSys

@import Syscall

// Memory
@export memAlloc fun: size u32 -> a
    ret Allocator::FirstFit::instance.alloc(size)
;

@export memFree fun: adr a
    Allocator::FirstFit::instance.free(adr)
;

@export memCopy raw<"r, r, r, ~{esi}, ~{edi}, ~{ecx}, ~{memory}">: /*$0*/aSource a, /*$1*/aTarget a, /*$2*/size u32
    mov esi, $0
    mov edi, $1
    mov ecx, $2
    shr ecx, 2
    cld
    rep movsd
;

@export memSet raw<"r, r, r, ~{eax}, ~{edi}, ~{ecx}, ~{memory}">: /*$0*/value u8, /*$1*/aTarget a, /*$2*/size u32
    mov al, $0
    mov edi, $1
    mov ecx, $2
    cld
    rep stosb
;

// Print
printAttribute u8 <- 0x07

@export printChar fun: character u8
    @Syscall::Terminal::printCharacter(character, printAttribute)
;

@export setPrintAttribute fun: attribute u8
    printAttribute <- attribute
;

@export resetPrintAttribute fun
    printAttribute <- 0x07
;