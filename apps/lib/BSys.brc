@module BSys

@import Syscall

// Memory
@ memAlloc fun: size u32 -> a
    ret Allocator::FirstFit::instance.alloc(size)
;

@ memFree fun: adr a
    Allocator::FirstFit::instance.free(adr)
;

@ memCopy raw<"r, r, r, ~{esi}, ~{edi}, ~{ecx}, ~{memory}">: /*$0*/aSource a, /*$1*/aTarget a, /*$2*/size u32
    mov esi, $0
    mov edi, $1
    mov ecx, $2
    cld
    rep movsb
;

@ memSet raw<"r, r, r, ~{eax}, ~{edi}, ~{ecx}, ~{memory}">: /*$0*/value u8, /*$1*/aTarget a, /*$2*/size u32
    mov al, $0
    mov edi, $1
    mov ecx, $2
    cld
    rep stosb
;

// Print
printAttribute u8 <- 0x07

@ printChar fun: character u8
    @Syscall::Terminal::printCharacter(character, printAttribute)
;

@ setPrintAttribute fun: attribute u8
    printAttribute <- attribute
;

@ resetPrintAttribute fun
    printAttribute <- 0x07
;

// FsNode, File, Dir
@ fileOpen fun: a_path a -> u64
    ret @Syscall::System::grabResource(@Syscall::System::ResourceCategory::GET_STORAGE_ENTRY, a_path.u32, 0)
;

@ fileCreate fun: a_path a -> u64
    ret @Syscall::System::grabResource(@Syscall::System::ResourceCategory::CREATE_STORAGE_ENTRY, a_path.u32, 0)
;

@ fileClose fun: resId u64
    @Syscall::System::releaseResource(resId.u32)
;

@ fileGetSize fun: resId u64 -> u64
    ret @Syscall::Storage::getEntryInfo(resId.u32).entrySize
;

@ fileRead fun: resId u64, offset u64, size u64, a_target a -> u64
    ret @Syscall::Storage::readEntry(resId.u32, offset.u32, size.u32, a_target)
;

@ fileWrite fun: resId u64, offset u64, size u64, a_source a -> u64
    ret @Syscall::Storage::writeEntry(resId.u32, offset.u32, size.u32, a_source)
;

@ fileDelete fun: resId u64 -> bool
    @Syscall::Storage::deleteEntry(resId.u32)
    ret true
;

@ dirOpen fun: a_path a -> u64
    ret 0
;

@ dirCreate fun: a_path a -> u64
    ret 0
;

@ dirClose fun: resId u64
;

@ dirDelete fun: resId u64 -> bool
    ret false
;