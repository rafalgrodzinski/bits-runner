@module Syscall

@import B

syscallRaw raw<"=r, m, m, m, m, m, ~{eax}, ~{ebx}, ~{ecx}, ~{edx}, ~{esi}">: /*$1*/syscallNumber u32, /*$2*/arg0 u32, /*$3*/arg1 u32, /*s4*/arg2 u32, /*s5*/arg3 u32 -> /*$0*/u32
    mov eax, $1
    mov ebx, $2
    mov ecx, $3
    mov edx, $4
    mov esi, $5
    int 0x30
    mov $0, eax
;

// System
System::REBOOT u32 <- 0x000
System::GET_TIMESTAMP u32 <- 0x010
System::GET_INFO_PCI u32 <- 0x021
System::GRAB_RESOURCE u32 <- 0x030
System::RELEASE_RESOURCE u32 <- 0x031

@export System::ResourceCategory::GET_STORAGE_ENTRY u32 <- 0x01
@export System::ResourceCategory::CREATE_STORAGE_ENTRY u32 <- 0x02
@export System::ResourceCategory::VIDEO_GET_SURFACE u32 <- 0x03

@export InfoPciDevice blob
        busNum u32
        deviceNum u32
        funNum u32

        vendorId u32
        deviceId u32
        class u32
        subclass u32
;

@export InfoPci blob
    devicesCount u32
    devices data<blob<InfoPciDevice>, 16>
;

@export System::reboot fun
    syscallRaw(System::REBOOT, 0, 0, 0, 0)
;

@export System::getTimestamp fun -> u32
    ret syscallRaw(System::GET_TIMESTAMP, 0, 0, 0, 0)
;

@export System::getInfoPci fun -> blob<InfoPci>
    info blob<InfoPci>
    syscallRaw(System::GET_INFO_PCI, info.adr.u32, 0, 0, 0)
    ret info
;

@export System::grabResource fun: category u32, arg0 u32, arg1 u32 -> u32
    ret syscallRaw(System::GRAB_RESOURCE, category, arg0, arg1, 0)
;

@export System::releaseResource fun: resourceId u32
    syscallRaw(System::RELEASE_RESOURCE, resourceId, 0, 0, 0)
;

// Memory
Memory::GET_INFO u32 <- 0x100

@export InfoMem blob
    totalSize u32
    totalPages u32
    unavailablePages u32
    freePages u32

    kernelPages u32
    kernelStackPages u32
    userPages u32

    kernelHeapStart u32
    kernelHeapSize u32
    kernelAllocateBytes u32
;

@export Memory::getInfo fun -> blob<InfoMem>
    info blob<InfoMem>
    syscallRaw(Memory::GET_INFO, info.adr.u32, 0, 0, 0)
    ret info
;

// Process
Process::YIELD u32 <- 0x200
Process::SLEEP u32 <- 0x201

@export Process::yield fun
    syscallRaw(Process::YIELD, 0, 0, 0, 0)
;

@export Process::sleep fun: milliseconds u32
    syscallRaw(Process::SLEEP, milliseconds, 0, 0, 0)
;

// Storage
Storage::GET_ENTRY_INFO u32 <- 0x300
Storage::DELETE_ENTRY u32 <- 0x301
Storage::READ_ENTRY u32 <- 0x302
Storage::WRITE_ENTRY u32 <- 0x303

@export Storage::ENTRY_KIND_EMPTY u32 <- 0
@export Storage::ENTRY_KIND_FILE u32 <- 'f'
@export Storage::ENTRY_KIND_DIRECTORY u32 <- 'd'

@export Storage::EntryInfo blob
    kind u32
    entrySize u32
;

@export Storage::getEntryInfo fun: resourceId u32 -> blob<Storage::EntryInfo>
    entryInfo blob<Storage::EntryInfo>
    syscallRaw(Storage::GET_ENTRY_INFO, resourceId, entryInfo.adr.u32, 0, 0)
    ret entryInfo
;

@export Storage::deleteEntry fun: resourceId u32
    syscallRaw(Storage::DELETE_ENTRY, resourceId, 0, 0, 0)
;

@export Storage::readEntry fun: resourceId u32, startByte u32, bytesCount u32, targetAddress a -> u32
    ret syscallRaw(Storage::READ_ENTRY, resourceId, startByte, bytesCount, targetAddress.u32)
;

@export Storage::writeEntry fun: resourceId u32, startByte u32, bytesCount u32, sourceAddress a -> u32
    ret syscallRaw(Storage::WRITE_ENTRY, resourceId, startByte, bytesCount, sourceAddress.u32)
;

// Input
Input::KEYBOARD_GET_ASCII u32 <- 0x401
Input::MOUSE_GET_STATE u32 <- 0x410

@export MouseState blob
    buttonsState u32
    deltaX s32
    deltaY s32
;

@export Input::getAscii fun -> u32
    ret syscallRaw(Input::KEYBOARD_GET_ASCII, 0, 0, 0, 0)
;

@export Input::getMouseState fun -> blob<MouseState>
    mouseState blob<MouseState>
    syscallRaw(Input::MOUSE_GET_STATE, mouseState.adr.u32, 0, 0, 0)
    ret mouseState
;

// Terminal
Terminal::PRINT_CHARACTER u32 <- 0x501

@export Terminal::printCharacter fun: character u8, attribute u8
    syscallRaw(Terminal::PRINT_CHARACTER, character, attribute, 0, 0)
;

// Video
Video::GET_MODES_COUNT u32 <- 0x600
Video::GET_MODE_INFO u32 <- 0x601

Video::COMMIT u32 <- 0x610

Video::CLEAR u32 <- 0x620
Video::DRAW_PIXEL u32 <- 0x621
Video::DRAW_LINE u32 <- 0x622

@export Video::ModeInfo blob
    id u32
    width u32
    height u32
    bpp u32
;

@export Video::getModesCount fun -> u32
    ret syscallRaw(Video::GET_MODES_COUNT, 0, 0, 0, 0)
;

@export Video::getModeInfo fun: index u32 -> blob<Video::ModeInfo>
    modeInfo blob<Video::ModeInfo>
    syscallRaw(Video::GET_MODE_INFO, modeInfo.adr.u32, index, 0, 0)
    ret modeInfo
;

@export Video::commit fun: resourceId u32
    syscallRaw(Video::COMMIT, resourceId, 0, 0, 0)
;

@export Video::clear fun: resourceId u32, red u8, green u8, blue u8
    color u32 <- (red << 16) | (green << 8) | (blue << 0)
    syscallRaw(Video::CLEAR, resourceId, color, 0, 0)
;

@export Video::drawPixel fun: resourceId u32, x u32, y u32, red u8, green u8, blue u8
    color u32 <- (red << 16) | (green << 8) | (blue << 0)
    syscallRaw(Video::DRAW_PIXEL, resourceId, x, y, color)
;

@export Video::drawLine fun: resourceId u32, x1 u32, y1 u32, x2 u32, y2 u32, red u8, green u8, blue u8
    p1 u32 <- (x1 << 16) | (y1 & 0xffff)
    p2 u32 <- (x2 << 16) | (y2 & 0xffff)
    color u32 <- (red << 16) | (green << 8) | (blue << 0)
    syscallRaw(Video::DRAW_LINE, resourceId, p1, p2, color)
;

// Audio
Audio::PLAY u32 <- 0x700
Audio::STOP u32 <- 0x701

@export Audio::play fun: frequency u32, durationMs u32
    syscallRaw(Audio::PLAY, frequency, durationMs, 0, 0)
;

@export Audio::stop fun
    syscallRaw(Audio::STOP, 0, 0, 0, 0)
;

// Debug
Debug::DUMP_STACK u32 <- 0x00
Debug::DUMP_PAGING u32 <- 0x01
Debug::DUMP_MEMORY u32 <- 0x02

@export debugCallRaw raw<"m, m, m, ~{eax}, ~{ebx}, ~{ecx}">: /*$0*/debugCallNumber u32, /*$1*/arg0 u32, /*$2*/arg1 u32
    mov eax, $0
    mov ebx, $1
    mov ecx, $2
    int 0x32
;

@export Debug::dumpCpuState raw
    int 0x31
;

@export Debug::dumpStack fun: size u32
    debugCallRaw(Debug::DUMP_STACK, size, 0)
;

@export Debug::dumpPaging fun
    debugCallRaw(Debug::DUMP_PAGING, 0, 0)
;

@export Debug::dumpMemory fun: aMem a, size u32
    debugCallRaw(Debug::DUMP_MEMORY, aMem.u32, size)
;