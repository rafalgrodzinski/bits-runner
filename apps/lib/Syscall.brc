@module Syscall

syscallRaw raw<"={eax}, m, m, m, m, m, m, ~{ebx}, ~{ecx}, ~{edx}, ~{esi}, ~{edi}">: /*$1*/syscallNumber u32, /*$2*/arg0 u32, /*$3*/arg1 u32, /*s4*/arg2 u32, /*s5*/arg3 u32, /*s6*/arg4 u32 -> /*$0*/u32
    mov eax, $1
    mov ebx, $2
    mov ecx, $3
    mov edx, $4
    mov esi, $5
    mov edi, $6
    int 0x30
    mov $0, eax
;

// System
System::REBOOT u32 <- 0x000
System::GET_TIMESTAMP u32 <- 0x010
System::GET_INFO_PCI u32 <- 0x021
System::GRAB_RESOURCE u32 <- 0x030
System::RELEASE_RESOURCE u32 <- 0x031

@ System::ResourceCategory::GET_STORAGE_ENTRY u32 <- 0x01
@ System::ResourceCategory::CREATE_STORAGE_ENTRY u32 <- 0x02
@ System::ResourceCategory::VIDEO_GET_SURFACE u32 <- 0x03

@ InfoPciDevice blob
        @ busNum u32
        @ deviceNum u32
        @ funNum u32

        @ vendorId u32
        @ deviceId u32
        @ class u32
        @ subclass u32
;

@ InfoPci blob
    devicesCount u32
    devices data<blob<InfoPciDevice>, 16>
;

@ System::reboot fun
    syscallRaw(System::REBOOT, 0, 0, 0, 0, 0)
;

@ System::getTimestamp fun -> u32
    ret syscallRaw(System::GET_TIMESTAMP, 0, 0, 0, 0, 0)
;

@ System::getInfoPci fun -> blob<InfoPci>
    info blob<InfoPci>
    syscallRaw(System::GET_INFO_PCI, info.adr.u32, 0, 0, 0, 0)
    ret info
;

@ System::grabResource fun: category u32, arg0 u32, arg1 u32 -> u32
    ret syscallRaw(System::GRAB_RESOURCE, category, arg0, arg1, 0, 0)
;

@ System::releaseResource fun: resourceId u32
    syscallRaw(System::RELEASE_RESOURCE, resourceId, 0, 0, 0, 0)
;

// Memory
Memory::GET_INFO u32 <- 0x100
Memory::EXPAND_HEAP u32 <- 0x101

@ Memory::Info blob
    @ totalSize u32
    @ totalPagesCount u32
    @ unavailablePagesCount u32
    @ freePagesCount u32

    @ kernelPagesCount u32
    @ kernelStackPagesCount u32

    @ kernelHeapAdr a
    @ kernelHeapSize u32
    @ kernelHeapUsedSize u32

    @ userPagesCount u32
    @ userStackPagesCount u32
;

@ Memory::getInfo fun -> blob<Memory::Info>
    info blob<Memory::Info>
    syscallRaw(Memory::GET_INFO, info.adr.u32, 0, 0, 0, 0)
    ret info
;

@ Memory::expandHeap fun: size u32 -> u32
    ret syscallRaw(Memory::EXPAND_HEAP, size, 0, 0, 0, 0)
;

// Process
Process::YIELD u32 <- 0x200
Process::SLEEP u32 <- 0x201

@ Process::yield fun
    syscallRaw(Process::YIELD, 0, 0, 0, 0, 0)
;

@ Process::sleep fun: milliseconds u32
    syscallRaw(Process::SLEEP, milliseconds, 0, 0, 0, 0)
;

// Storage
Storage::GET_ENTRY_INFO u32 <- 0x300
Storage::DELETE_ENTRY u32 <- 0x301
Storage::READ_ENTRY u32 <- 0x302
Storage::WRITE_ENTRY u32 <- 0x303

@ Storage::ENTRY_KIND_EMPTY u32 <- 0
@ Storage::ENTRY_KIND_FILE u32 <- 'f'
@ Storage::ENTRY_KIND_DIRECTORY u32 <- 'd'

@ Storage::EntryInfo blob
    @ kind u32
    @ entrySize u32
;

@ Storage::getEntryInfo fun: resId u32 -> blob<Storage::EntryInfo>
    entryInfo blob<Storage::EntryInfo>
    syscallRaw(Storage::GET_ENTRY_INFO, resId, entryInfo.adr.u32, 0, 0, 0)
    ret entryInfo
;

@ Storage::deleteEntry fun: resId u32
    syscallRaw(Storage::DELETE_ENTRY, resId, 0, 0, 0, 0)
;

@ Storage::readEntry fun: resId u32, offset u32, size u32, a_target a -> u32
    ret syscallRaw(Storage::READ_ENTRY, resId, offset, size, a_target.u32, 0)
;

@ Storage::writeEntry fun: resId u32, offset u32, size u32, a_source a -> u32
    ret syscallRaw(Storage::WRITE_ENTRY, resId, offset, size, a_source.u32, 0)
;

// Input
Input::KEYBOARD_GET_ASCII u32 <- 0x401
Input::MOUSE_GET_STATE u32 <- 0x410

@ MouseState blob
    @ buttonsState u32
    @ deltaX s32
    @ deltaY s32
    @ deltaZ s32
;

@ Input::getAscii fun -> u32
    ret syscallRaw(Input::KEYBOARD_GET_ASCII, 0, 0, 0, 0, 0)
;

@ Input::getMouseState fun -> blob<MouseState>
    mouseState blob<MouseState>
    syscallRaw(Input::MOUSE_GET_STATE, mouseState.adr.u32, 0, 0, 0, 0)
    ret mouseState
;

// Terminal
Terminal::PRINT_CHARACTER u32 <- 0x501

@ Terminal::printCharacter fun: character u8, attribute u8
    syscallRaw(Terminal::PRINT_CHARACTER, character, attribute, 0, 0, 0)
;

// Video
Video::GET_MODES_COUNT u32 <- 0x600
Video::GET_MODE_INFO u32 <- 0x601

Video::COMMIT u32 <- 0x610

Video::CLEAR u32 <- 0x620
Video::DRAW_PIXEL u32 <- 0x621
Video::DRAW_LINE u32 <- 0x622
Video::DRAW_BITMAP u32 <- 0x623

@ Video::ModeInfo blob
    @ id u32
    @ width u32
    @ height u32
    @ bpp u32
;

@ Video::getModesCount fun -> u32
    ret syscallRaw(Video::GET_MODES_COUNT, 0, 0, 0, 0, 0)
;

@ Video::getModeInfo fun: index u32 -> blob<Video::ModeInfo>
    modeInfo blob<Video::ModeInfo>
    syscallRaw(Video::GET_MODE_INFO, modeInfo.adr.u32, index, 0, 0, 0)
    ret modeInfo
;

@ Video::commit fun: resourceId u32
    syscallRaw(Video::COMMIT, resourceId, 0, 0, 0, 0)
;

@ Video::clear fun: resourceId u32, red u8, green u8, blue u8
    rgb u32 <- (red << 16) | (green << 8) | (blue << 0)
    syscallRaw(Video::CLEAR, resourceId, rgb, 0, 0, 0)
;

@ Video::drawPixel fun: resourceId u32, x u32, y u32, red u8, green u8, blue u8
    rgb u32 <- (red << 16) | (green << 8) | (blue << 0)
    syscallRaw(Video::DRAW_PIXEL, resourceId, x, y, rgb, 0)
;

@ Video::drawLine fun: resourceId u32, x1 u32, y1 u32, x2 u32, y2 u32, red u8, green u8, blue u8
    xy1 u32 <- (x1 << 16) | (y1 & 0xffff)
    xy2 u32 <- (x2 << 16) | (y2 & 0xffff)
    rgb u32 <- (red << 16) | (green << 8) | (blue << 0)
    syscallRaw(Video::DRAW_LINE, resourceId, xy1, xy2, rgb, 0)
;

@ Video::drawBitmap fun: resId u32, x u32, y u32, width u32, height u32, bpp u32, a_data a
    xy u32 <- (x << 16) | (y & 0xffff)
    wh u32 <- (width << 16) | (height & 0xffff)
    syscallRaw(Video::DRAW_BITMAP, resId, xy, wh, bpp, a_data.u32)
;

// Audio
Audio::PLAY u32 <- 0x700
Audio::STOP u32 <- 0x701

@ Audio::play fun: frequency u32, durationMs u32
    syscallRaw(Audio::PLAY, frequency, durationMs, 0, 0, 0)
;

@ Audio::stop fun
    syscallRaw(Audio::STOP, 0, 0, 0, 0, 0)
;

// Debug
Debug::DUMP_PAGING u32 <- 0x00
Debug::DUMP_STACK u32 <- 0x01
Debug::DUMP_MEMORY u32 <- 0x02

@ debugCallRaw raw<"m, m, m, ~{eax}, ~{ebx}, ~{ecx}">: /*$0*/debugCallNumber u32, /*$1*/arg0 u32, /*$2*/arg1 u32
    mov eax, $0
    mov ebx, $1
    mov ecx, $2
    int 0x32
;

@ Debug::dumpCpuState raw
    int 0x31
;

@ Debug::dumpPaging fun
    debugCallRaw(Debug::DUMP_PAGING, 0, 0)
;

@ Debug::dumpStack fun: size u32
    debugCallRaw(Debug::DUMP_STACK, size, 0)
;

@ Debug::dumpMemory fun: aMem a, size u32
    debugCallRaw(Debug::DUMP_MEMORY, aMem.u32, size)
;