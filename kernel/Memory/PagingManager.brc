@module Memory

@import BSys
@import B
@import Dispatch

@export MemoryLayout blob
    kernelImageSize u32
    pageSize u32
    pagesCount u32
    memoryPages data<u8, 0>
;

KERNEL_ADR u32 <- 0x8000_0000 // @ 2GiB

@export PagingManager::PAGE_UNAVAILABLE u8 <- 0xff
@export PagingManager::PAGE_FREE u8 <- 0x00
@export PagingManager::PAGE_KERNEL u8 <- 0x10
@export PagingManager::PAGE_KERNEL_STACK u8 <- 0x11
@export PagingManager::PAGE_USER u8 <- 0x20
@export PagingManager::PAGE_USER_STACK u8 <- 0x21
@export PagingManager::PAGE_DIRECT_MAPPING u8 <- 0x30

PagingManager::PAGES_TABLE_SIZE u32 <- u32.size * 1024
PagingManager::PAGE_TABLES_ADR a <- 0xffc0_0000
PagingManager::PAGE_TABLES_DIRECTORY_ADR a <- 0xffff_f000

@export PagingManager::FLAGS_RWP u32 <- 0b0011 // Read-Write, Present
@export PagingManager::FLAGS_URWP u32 <- 0b0111 // User, Read-Write, Present

@export PagingManager::instance blob<PagingManager>

@export PagingManager blob
    pMemoryLayout ptr<blob<MemoryLayout>>
    unavailablePagesCount u32
    freePagesCount u32
    kernelPagesCount u32
    kernelStackPagesCount u32

    init fun
        it.pMemoryLayout <- {heap.adr + PagingManager::PAGES_TABLE_SIZE * 4} // first 4096 bytes for page tables directory + 3 * 4096 bytes for page tables
        // Figure out pages stats
        rep i u32 <- 0, i < it.pMemoryLayout.val.pagesCount, i <- i + 1
            if it.pMemoryLayout.val.memoryPages[i] = PagingManager::PAGE_FREE: it.freePagesCount <- it.freePagesCount + 1
            else if it.pMemoryLayout.val.memoryPages[i] = PagingManager::PAGE_KERNEL: it.kernelPagesCount <- it.kernelPagesCount + 1
            else if it.pMemoryLayout.val.memoryPages[i] = PagingManager::PAGE_KERNEL_STACK: it.kernelStackPagesCount <- it.kernelStackPagesCount + 1
            else
                it.pMemoryLayout.val.memoryPages[i] <- PagingManager::PAGE_UNAVAILABLE
                it.unavailablePagesCount <- it.unavailablePagesCount + 1
            ;
        ;
    ;

    allocateKernelPages fun: pProcess ptr<blob<@Dispatch::Process>>, pageTag u8, size u32, linearAddress u32 -> u32
        @BSys::disableInterrupts()

        allocatedSize u32 <- it.allocatePages(
            pProcess,
            pageTag,
            size,
            linearAddress
        )

        @BSys::enableInterrupts()

        ret allocatedSize
    ;

    allocateUserPages fun: pProcess ptr<blob<@Dispatch::Process>>, pCurrentPageTablesDirectory ptr<data<u32>>, pageTag u8, size u32, linearAddress u32 -> u32
        @BSys::disableInterrupts()
        currentSelfReference u32 <- pCurrentPageTablesDirectory.val[1023] & 0xffff_f000
        selfReference u32 <- PagingManager::lAdrToPAdr(pProcess.val.pageTablesDirectory.adr).u32 | PagingManager::FLAGS_RWP
        pCurrentPageTablesDirectory.val[1023] <- selfReference
        PagingManager::flushTlbRaw()

        allocatedSize u32 <- it.allocatePages(
            pProcess,
            pageTag,
            size,
            linearAddress
        )

        // and restore the original self-reference
        pCurrentPageTablesDirectory.val[1023] <- currentSelfReference | PagingManager::FLAGS_RWP
        PagingManager::flushTlbRaw()
        @BSys::enableInterrupts()

        ret allocatedSize
    ;

    allocatePages fun: pProcess ptr<blob<@Dispatch::Process>>, pageTag u8, size u32, linearAddress u32 -> u32
        // check if we have enough remaining pages
        requestedPagesCount u32 <- (size + it.pMemoryLayout.val.pageSize - 1) / it.pMemoryLayout.val.pageSize
        if it.freePagesCount < requestedPagesCount: ret 0

        remainingPagesCount u32 <- requestedPagesCount

        rep i u32, remainingPagesCount > 0, i <- i + 1
            if it.pMemoryLayout.val.memoryPages[i] = PagingManager::PAGE_FREE
                pageIndex u32 <- requestedPagesCount - remainingPagesCount
                it.registerPageForLinearAddress(
                    i,
                    pageTag,
                    linearAddress + pageIndex * it.pMemoryLayout.val.pageSize
                )
                
                remainingPagesCount <- remainingPagesCount - 1

                if pProcess.vadr != 0: pProcess.val.registerPage(i)
            ;
        ;

        if pageTag = PagingManager::PAGE_KERNEL
            it.kernelPagesCount <- it.kernelPagesCount + requestedPagesCount
        else if pageTag = PagingManager::PAGE_KERNEL_STACK
            it.kernelStackPagesCount <- it.kernelStackPagesCount + requestedPagesCount
        ;

        it.freePagesCount <- it.freePagesCount - requestedPagesCount
        ret requestedPagesCount * it.pMemoryLayout.val.pageSize
    ;

    registerPageForLinearAddress fun: pageIndex u32, pageTag u8, linearAddress u32
        // register in bitmap if not directly mapped
        if pageTag != PagingManager::PAGE_DIRECT_MAPPING
            it.pMemoryLayout.val.memoryPages[pageIndex] <- pageTag
        ;

        // calculate directory and table index based on the desired linear address
        tableIndex u32 <- (linearAddress & 0xffc0_0000) >> 22
        pageEntryIndex u32 <- (linearAddress & 0x003f_f000) >> 12
        pPageTablesDirectory ptr<data<u32>> <- {PagingManager::PAGE_TABLES_DIRECTORY_ADR}
        pPagesTable ptr<data<u32>> <- {PagingManager::PAGE_TABLES_ADR + tableIndex * PagingManager::PAGES_TABLE_SIZE}

        flags u32 <- if pageTag = PagingManager::PAGE_USER or pageTag = PagingManager::PAGE_USER_STACK: PagingManager::FLAGS_URWP else: PagingManager::FLAGS_RWP

        // create pages table if it doesn't exist
        if pPageTablesDirectory.val[tableIndex] &? 0x01 = false
            freePageIndex u32
            rep it.pMemoryLayout.val.memoryPages[freePageIndex] != PagingManager::PAGE_FREE: freePageIndex <- freePageIndex + 1
            it.pMemoryLayout.val.memoryPages[freePageIndex] <- PagingManager::PAGE_KERNEL

            pPageTablesDirectory.val[tableIndex] <- (freePageIndex * it.pMemoryLayout.val.pageSize) | flags
            PagingManager::flushTlbRaw()
            rep i u32 <- 0, i < 1024, i <- i + 1: pPagesTable.val[i] <- 0
        ;

        // update new table entries relative to the last directory entry
        pPagesTable.val[pageEntryIndex] <- (pageIndex * it.pMemoryLayout.val.pageSize) | flags
        PagingManager::flushTlbRaw()
    ;

    mapDirectMemory fun: memStart u32, memSize u32
        memOffset u32 <- memStart % it.pMemoryLayout.val.pageSize
        startPage u32 <- memStart / it.pMemoryLayout.val.pageSize
        pagesCount u32 <- (memOffset + memSize + it.pMemoryLayout.val.pageSize - 1) / it.pMemoryLayout.val.pageSize

        @BSys::disableInterrupts()

        rep pageIndex u32 <- startPage, pageIndex < startPage + pagesCount, pageIndex <- pageIndex + 1
            it.registerPageForLinearAddress(
                pageIndex,
                PagingManager::PAGE_DIRECT_MAPPING,
                pageIndex * it.pMemoryLayout.val.pageSize
            )
        ;

        @BSys::enableInterrupts()
    ;

    getInfoTotalSize fun -> u32
        ret it.pMemoryLayout.val.pagesCount * it.pMemoryLayout.val.pageSize
    ;

    getInfoTotalPages fun -> u32
        ret it.pMemoryLayout.val.pagesCount
    ;

    getInfoUnavailablePages fun -> u32
        ret it.unavailablePagesCount
    ;

    getInfoFreePages fun -> u32
        ret it.freePagesCount
    ;

    getInfoKernelPages fun -> u32
        ret it.kernelPagesCount
    ;

    getInfoKernelStackPages fun -> u32
        ret it.kernelStackPagesCount
    ;
;

PagingManager::flushTlbRaw raw<"~{eax}, ~{memory}">
    mov eax, cr3
    mov cr3, eax
;

@export PagingManager::lAdrToPAdr fun: lAdr a -> a
    pPageDirectory ptr<data<u32>> <- {0xffc0_0000}

    tableIndex u32 <- (lAdr.u32 & 0xffc0_0000) >> 22
    pageEntryIndex u32 <- (lAdr.u32 & 0x003f_f000) >> 12
    offset u32 <- lAdr.u32 & 0x0000_0fff

    pageEntry u32 <- pPageDirectory.val[tableIndex * 1024 + pageEntryIndex]
    
    ret (pageEntry & 0xffff_f000) + offset
;