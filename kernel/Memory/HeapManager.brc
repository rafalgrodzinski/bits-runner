@module Memory

@export heap u32 // marks start of the kernel heap, set by linker in kernel.ld

@export HeapManager::instance blob<HeapManager>

@export HeapManager blob
    allocator blob<Allocator::FirstFit>

    init fun
        pMemoryLayout ptr<blob<MemoryLayout>> <- PagingManager::instance.pMemoryLayout
        kernelImagePagesCount u32 <- (pMemoryLayout.val.kernelImageSize + pMemoryLayout.val.pageSize - 1) / pMemoryLayout.val.pageSize

        it.allocator.init(
            heap.adr,
            (PagingManager::instance.kernelPagesCount - kernelImagePagesCount) * pMemoryLayout.val.pageSize,
            0x1000 * 4 + blob<MemoryLayout>.size + pMemoryLayout.val.pagesCount
        )
    ;

    allocAligned fun: pProcess ptr<blob<@Dispatch::Process>>, size u32, shouldClear bool, alignment u32 -> a
        ret it.allocator.alloc(size, alignment, shouldClear)
    ;

    free fun: adr a
        it.allocator.free(adr)
    ;

    getHeapAdr fun -> a
        ret it.allocator.getAdr()
    ;

    getHeapSize fun -> u32
        ret it.allocator.getSize()
    ;

    getHeapUsedSize fun -> u32
        ret it.allocator.getUsedSize()
    ;
;