        */
    ;

    free fun: adr a
        it.allocator.free(adr)
    ;

    getInfoHeapStart fun -> u32
        ret 0//it.heapLayout.pHeapStart.vadr.u32
    ;

    getInfoHeapSize fun -> u32
        ret 0//it.heapLayout.heapSize
    ;

    getInfoAllocatedBytes fun -> u32
        ret 0//it.heapLayout.allocatedBytes
    ;
;