@module Devices

@import BSys

Serial::COM_1 u16 <- 0x03f8
Serial::COM_2 u16 <- 0x02f8

@ Serial::instance blob<Serial>

@ Serial blob
    @ init fun
        @BSys::out8(Serial::COM_1 + 1, 0x00) // Disable all interrupts
        @BSys::out8(Serial::COM_1 + 3, 0x80) // Enable DLAB (set baud rate divisor)
        @BSys::out8(Serial::COM_1 + 0, 0x03) // Set divisor to 3 (lo byte) 38400 baud
        @BSys::out8(Serial::COM_1 + 1, 0x00) //                  (hi byte)
        @BSys::out8(Serial::COM_1 + 3, 0x03) // 8 bits, no parity, one stop bit
        @BSys::out8(Serial::COM_1 + 2, 0xc7) // Enable FIFO, clear them, with 14-byte threshold
        @BSys::out8(Serial::COM_1 + 4, 0x0b) // IRQs enabled, RTS/DSR set
        @BSys::out8(Serial::COM_1 + 4, 0x0f) // IRQs enabled and OUT#1 and OUT#2 bits enabled
    ;

    @ write fun: value u8
        rep not @BSys::in8(Serial::COM_1 + 5) &? 0x20:
        @BSys::out8(Serial::COM_1, value)
    ;
;