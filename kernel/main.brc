@import B
@import BSys
@import Term
@import Memory
@import BiosService
@import Dispatch
@import Storage
@import BSys
@import Interrupt
@import Bus
@import Devices
@import Video

busPci blob<@Bus::BusPci>

@export start fun
    // Get boot parameters from BIOS Service
    biosServiceAdr u32 <- @BSys::getEax()
    gdtTssAdr u32 <- @BSys::getEbx()
    bootPartitionFirstSector u32 <- @BSys::getEcx()
    biosBootDriveNumber u32 <- @BSys::getEdx()

    // Initialize subsystems
    @BiosService::init(biosServiceAdr)
    @Dispatch::Dispatcher::instance.init(gdtTssAdr)
    @Memory::PagingManager::instance.init()
    @Memory::HeapManager::instance.init()
    @Interrupt::Handler::instance.init()
    @Term::init(@Term::MODE_80x50)

    @B::String("Initializing Bits Runner...").println()
    @Devices::Timer::Pit::instance.init()
    //busPci.scan()
    @Storage::instance.init(biosBootDriveNumber, bootPartitionFirstSector)
    @Video::instance.init()
    
    @B::String("All ready, welcome to Bits Runner!\n").printlnColor(@B::String::FOREGROUND_GREEN)

    // Load apps
    pEntry ptr<blob<@Storage::Entry>>
    aFileBuffer a

    /*
    // Load shell
    //pEntry <- @Storage::instance.bootFilesystem.getEntry(@B::String("/APPS/SHELL.BIN"))
    pEntry <- @Storage::instance.bootFilesystem.getEntry(@B::String("/APPS/VDEMO.BIN"))
    aFileBuffer <- @BSys::memAlloc(pEntry.val.fileSize)
    pEntry.val.read(0, pEntry.val.fileSize, aFileBuffer)
    @Dispatch::Dispatcher::instance.createProcess(aFileBuffer, pEntry.val.fileSize)
    @BSys::memFree(pEntry.vadr)
    */

    //videoVesa.init()

    modes blob<@B::Array, ptr<blob<@Video::Adapter::Mode>>> <- @Video::instance.primaryAdapter.getModes()
    rep i u32, i < modes.count, i <- i + 1
        pMode ptr<blob<@Video::Adapter::Mode>> <- modes.at(i).ptr<blob<@Video::Adapter::Mode>>
        @B::StringHexForU32(pMode.val.id).print()
        @B::String(" ").print()

        @B::StringForU32(pMode.val.width).print()
        @B::String("x").print()
        @B::StringForU32(pMode.val.height).print()
        @B::String("x").print()
        @B::StringForU32(pMode.val.bpp).println()
    ;

    @Dispatch::Dispatcher::instance.start()
;