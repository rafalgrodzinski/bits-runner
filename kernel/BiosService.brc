@module BiosService

Service::REBOOT u32 <- 0x00
Service::BOOT_STORAGE_READ_SECTORS u32 <- 0x02
Service::BOOT_STORAGE_WRITE_SECTORS u32 <- 0x04
Service::GET_SECTORS_COUNT u32 <- 0x03

Service::Input::KEYBOARD_GET_SCAN_CODE_WAITING u32 <- 0x10
Service::Input::KEYBOARD_GET_KEY u32 <- 0x11
Service::Input::MOUSE_INIT u32 <- 0x12
Service::Input::MOUSE_UPDATE u32 <- 0x13

Service::Video::VGA_SET_MODE u32 <- 0x20
Service::Video::VESA_GET_INFO u32 <- 0x21
Service::Video::VESA_GET_MODE_INFO u32 <- 0x22
Service::Video::VESA_SET_MODE u32 <- 0x23
Service::Video::VESA_SET_DISPLAY_START u32 <- 0x24
Service::Video::VESA_GET_FUNCTIONS_TABLE u32 <- 0x25
Service::Video::VESA_SET_PALETTE u32 <- 0x26

@ VIDEO_MODE_TEXT_80x25 u32 <- 0x00
@ VIDEO_MODE_TEXT_80x50 u32 <- 0x01
@ VIDEO_MODE_GPX_320x200x8 u32 <- 0x02
@ VIDEO_MODE_GPX_640x480x4 u32 <- 0x03

aBiosService a

@ init fun: biosServiceAdr u32
    aBiosService <- biosServiceAdr
;

biosServiceCallRaw raw<"=r, m, m, m, m, m, ~{eax}, ~{ebx}, ~{ecx}, ~{edx}, ~{memory}">: /*$1*/biosServiceAddress u32, /*$2*/serviceNumber u32, /*$3*/arg0 u32, /*$4*/arg1 u32, /*$5*/arg2 u32 -> /*$0*/u32
    mov eax, $2
    mov ebx, $3
    mov ecx, $4
    mov edx, $5
    call $1
    mov $0, eax
;

// System
@ reboot fun
    biosServiceCallRaw(aBiosService.u32, Service::REBOOT, 0, 0, 0)
;

// Storage
@ bootStorageReadSectors fun: firstSector u32, sectorsCount u32, aTarget a -> u32
    ret biosServiceCallRaw(aBiosService.u32, Service::BOOT_STORAGE_READ_SECTORS, firstSector, sectorsCount, aTarget.u32)
;

@ bootStorageWriteSectors fun: firstSector u32, sectorsCount u32, aSource a -> u32
    ret biosServiceCallRaw(aBiosService.u32, Service::BOOT_STORAGE_WRITE_SECTORS, firstSector, sectorsCount, aSource.u32)
;

@ bootStorageGetSectorsCount fun -> u32
    ret biosServiceCallRaw(aBiosService.u32, Service::GET_SECTORS_COUNT, 0, 0, 0)
;

// Input
@ Input::keyboardGetScanCodeWaiting fun -> u8
    ret biosServiceCallRaw(aBiosService.u32, Service::Input::KEYBOARD_GET_SCAN_CODE_WAITING, 0, 0, 0).u8
;

@ Input::keyboardGetKey fun -> u16
    ret biosServiceCallRaw(aBiosService.u32, Service::Input::KEYBOARD_GET_KEY, 0, 0, 0).u16
;

@ Input::mouseInit fun -> a
    ret biosServiceCallRaw(aBiosService.u32, Service::Input::MOUSE_INIT, 0, 0, 0).a
;

@ Input::mouseUpdate fun
    biosServiceCallRaw(aBiosService.u32, Service::Input::MOUSE_UPDATE, 0, 0, 0)
;

// Video
@ Video::vgaSetMode fun: videoMode u32
    biosServiceCallRaw(aBiosService.u32, Service::Video::VGA_SET_MODE, videoMode, 0, 0)
;

@ Video::vesaGetInfo fun: aInfo a
    biosServiceCallRaw(aBiosService.u32, Service::Video::VESA_GET_INFO, aInfo.u32, 0, 0)
;

@ Video::vesaGetModeInfo fun: aModeInfo a, mode u32
    biosServiceCallRaw(aBiosService.u32, Service::Video::VESA_GET_MODE_INFO, aModeInfo.u32, mode, 0)
;

@ Video::vesaSetMode fun: mode u32
    biosServiceCallRaw(aBiosService.u32, Service::Video::VESA_SET_MODE, mode, 0, 0)
;

@ Video::vesaSetDisplayStart fun: xOffset u32, yOffset u32
    biosServiceCallRaw(aBiosService.u32, Service::Video::VESA_SET_DISPLAY_START, xOffset, yOffset, 0)
;

@ Video::vesaGetFunctionsTable fun -> a
    ret biosServiceCallRaw(aBiosService.u32, Service::Video::VESA_GET_FUNCTIONS_TABLE, 0, 0, 0).a
;

@ Video::vesaSetPalette fun: aPalette a
    biosServiceCallRaw(aBiosService.u32, Service::Video::VESA_SET_PALETTE, aPalette.u32, 0, 0)
;