@module Video

@import BiosService
@import B
@import Memory
@import BSys

VesaInfo blob
    signature data<u8, 4>
    version u16
    oemStringPtr data<u16, 2>
    caps data<u8, 4>
    videoModePtr data<u16, 2>
    memoryBlocksCount u16
    reserved data<u8, 492>
;

VesaModeInfo blob
    attributes u16
    u8 // windowA
    u8 //windowB
    u16 //granularity
    u16 // windowSize
    u16 // segmentA
    u16 //segmentB
    u32 // winFunPtr
    pitch u16
    width u16
    height u16
    u8 // xChar
    u8 // yChar
    u8 // planes
    bpp u8
    u8 // banks
    u8 // memoryModel
    u8 // bankSize
    u8 // imagePages
    u8 // reserved
    redSize u8
    redPosition u8
    greenSize u8
    greenPosition u8
    blueSize u8
    bluePosition u8
    u8 // reserved
    u8 // reserved
    u8 // directColorAttributes
    framebufferPtr u32
    u32 // offScreenMemoryOffset
    u16 // offScreenMemorySize
    data<u8, 206> // reserved
;

AdapterVesa::FRAMEBUFFER_ADR a <- 0xe000_0000

AdapterVesa::BUFFER_MODE_DEVICE u32 <- 0x00
AdapterVesa::BUFFER_MODE_RAM u32 <- 0x01

@export AdapterVesa blob: Adapter
    memoryBlocksCount u32
    modeIds blob<@B::Array, u16>
    modes blob<@B::Array, ptr<blob<Mode>>>

    aFrontPageBuffer a
    aBackPageBuffer a
    bufferMode u32

    aVesaFunctionsTable a
    
    init fun -> bool
        // Get adapter info
        vesaInfo blob_pack<VesaInfo>
        @BiosService::Video::vesaGetInfo(vesaInfo.adr)

        // Verify signature and version
        if vesaInfo.signature[0] != 'V' or vesaInfo.signature[1] != 'E' or vesaInfo.signature[2] != 'S' or vesaInfo.signature[3] != 'A': ret false
        if vesaInfo.version < 0x0200: ret false

        // Number of 64KiB blocks provided for framebuffer
        it.memoryBlocksCount <- vesaInfo.memoryBlocksCount

        // Get list of mode ids
        pModeIds ptr<data<u16>> <- {vesaInfo.videoModePtr[1] * 0x10 + vesaInfo.videoModePtr[0]}
        rep i u32, pModeIds.val[i] < 0xffff, i <- i + 1
            it.modeIds.push(pModeIds.val[i])
        ;

        // Get pointer to vesa functions table
        it.aVesaFunctionsTable <- @BiosService::Video::vesaGetFunctionsTable()

        @B::StringForChar(vesaInfo.signature[0]).print()
        @B::StringForChar(vesaInfo.signature[1]).print()
        @B::StringForChar(vesaInfo.signature[2]).print()
        @B::StringForChar(vesaInfo.signature[3]).println()
        @B::StringHexForU32(vesaInfo.version).println()
        @B::StringForU32(it.memoryBlocksCount).println()
        @B::StringHexForU32(it.aVesaFunctionsTable.u32).println()

        @BSys::debugPause(0x01)

        ret true
    ;

    getModes fun -> blob<@B::Array, ptr<blob<Mode>>>
        if it.modes.count > 0: ret it.modes

        // Get details for each of the modes
        rep i u32, i < it.modeIds.count, i <- i + 1
            vesaModeInfo blob_pack<VesaModeInfo>
            @BiosService::Video::vesaGetModeInfo(vesaModeInfo.adr, it.modeIds.at(i).u16)

            // Filter out weird color modes
            if vesaModeInfo.bpp = 8 or vesaModeInfo.bpp = 16 or vesaModeInfo.bpp = 24 or vesaModeInfo.bpp = 32
                pMode ptr<blob<Mode>> <- @BSys::memAlloc(blob<Mode>.size).ptr<blob<Mode>>

                pMode.val.id <- it.modeIds.at(i).u16
                pMode.val.width <- vesaModeInfo.width
                pMode.val.height <- vesaModeInfo.height
                pMode.val.bpp <- vesaModeInfo.bpp

                pMetadata ptr<blob<Mode::Metadata::Vesa>> <- @BSys::memAlloc(blob<Mode::Metadata::Vesa>.size).ptr<blob<Mode::Metadata::Vesa>>
                pMode.val.aMetadata <- pMetadata.vadr
                pMetadata.val.aFramebuffer <- vesaModeInfo.framebufferPtr.a
                pMetadata.val.pitch <- vesaModeInfo.pitch

                pMetadata.val.redSize <- vesaModeInfo.redSize
                pMetadata.val.redPosition <- vesaModeInfo.redPosition

                pMetadata.val.greenSize <- vesaModeInfo.greenSize
                pMetadata.val.greenPosition <- vesaModeInfo.greenPosition

                pMetadata.val.blueSize <- vesaModeInfo.blueSize
                pMetadata.val.bluePosition <- vesaModeInfo.bluePosition

                it.modes.push(pMode)

                @B::StringHexForU32(pMode.val.id).print()
                @B::String(" ").print()
                @B::StringForU32(pMode.val.width).print()
                @B::String("x").print()
                @B::StringForU32(pMode.val.height).print()
                @B::String("x").print()
                @B::StringForU32(pMode.val.bpp).print()
                @B::String(" ").print()
                @B::StringForU32(it.memoryBlocksCount).println()

                @B::String("R: ").print()
                @B::StringForU32(pMetadata.val.redSize).print()
                @B::String(" ").print()
                @B::StringForU32(pMetadata.val.redPosition).print()

                @B::String(" G: ").print()
                @B::StringForU32(pMetadata.val.greenSize).print()
                @B::String(" ").print()
                @B::StringForU32(pMetadata.val.greenPosition).print()

                @B::String(" B: ").print()
                @B::StringForU32(pMetadata.val.blueSize).print()
                @B::String(" ").print()
                @B::StringForU32(pMetadata.val.bluePosition).println()
            ;
        ;

        @BSys::debugPause(0x01)

        ret it.modes
    ;

    getSurface fun: pMode ptr<blob<Mode>> -> ptr<blob<Surface>>
        // Setup surface
        pSurface ptr<blob<Surface>> <- @BSys::memAlloc(blob<Surface>.size).ptr<blob<Surface>>
        pSurface.val.iAdapter <- {it.ptr}
        pSurface.val.pMode <- pMode

        // Setup adapter
        pMetadata ptr<blob<Mode::Metadata::Vesa>> <- pMode.val.aMetadata.ptr<blob<Mode::Metadata::Vesa>>
        @BiosService::Video::vesaSetMode(pMode.val.id)

        // Setup double buffering
        it.aFrontPageBuffer <- AdapterVesa::FRAMEBUFFER_ADR
        pageSize u32 <- pMetadata.val.pitch * pMode.val.height

        // On device double buffering
        if it.aVesaFunctionsTable != 0 and it.memoryBlocksCount >= (pageSize * 2 + 0x10_000 - 1) / 0x10_000
            it.bufferMode <- AdapterVesa::BUFFER_MODE_DEVICE
            it.aBackPageBuffer <- it.aFrontPageBuffer + pageSize
            @Memory::PagingManager::instance.mapMemory(it.aFrontPageBuffer, pMetadata.val.aFramebuffer, pageSize * 2)
        // In RAM double buffering
        else
            it.bufferMode <- AdapterVesa::BUFFER_MODE_RAM
            it.aBackPageBuffer <- @BSys::memAlloc(pageSize)
            @Memory::PagingManager::instance.mapMemory(it.aFrontPageBuffer, pMetadata.val.aFramebuffer, pageSize)
        ;

        // Set palette for RGB332 in case of 8 bit color
        if pMode.val.bpp = 8
            palette data<u8, 1024>

            rep i u32, i < 256, i <- i + 1
                red u8 <- (i.u8 & 0b1110_0000) >> 5
                green u8 <- (i.u8 & 0b0001_1100) >> 2
                blue u8 <- i.u8 & 0b0000_0011

                // Convert each component into 0..63 range
                palette[i * 4 + 0] <- blue * 21
                palette[i * 4 + 1] <- green * 9
                palette[i * 4 + 2] <- red * 9
            ;

            @BiosService::Video::vesaSetPalette(palette.adr)
        ;

        ret pSurface
    ;

    commit fun: pMode ptr<blob<Mode>>
        pMetadata ptr<blob<Mode::Metadata::Vesa>> <- pMode.val.aMetadata.ptr<blob<Mode::Metadata::Vesa>>

        if it.bufferMode = AdapterVesa::BUFFER_MODE_DEVICE
            // get offset to the new front display area
            displayOffset u32
            if it.aBackPageBuffer > it.aFrontPageBuffer
                displayOffset <- pMetadata.val.pitch * pMode.val.height / 4
            ;

            // swap front with back
            temp a <- it.aFrontPageBuffer
            it.aFrontPageBuffer <- it.aBackPageBuffer
            it.aBackPageBuffer <- temp

            // set new front buffer
            AdapterVesa::setDisplayStartRaw(it.aVesaFunctionsTable, displayOffset)
        else
            @BSys::memCopy(it.aBackPageBuffer, it.aFrontPageBuffer, pMetadata.val.pitch * pMode.val.height)
        ;
    ;

    clear fun: pMode ptr<blob<Mode>>, red u8, green u8, blue u8
        rep y u32, y < pMode.val.height, y <- y + 1
            rep x u32, x < pMode.val.width, x <- x + 1
                it.drawPixel(pMode, x, y, red, green, blue)
            ;
        ;
    ;

    drawPixel fun: pMode ptr<blob<Mode>>, x u32, y u32, red u8, green u8, blue u8
        pMetadata ptr<blob<Mode::Metadata::Vesa>> <- pMode.val.aMetadata.ptr<blob<Mode::Metadata::Vesa>>
        offset u32 <- y * pMetadata.val.pitch + (x * ((pMode.val.bpp + 7) / 8))

        // 8 bit color (RGB332)
        if pMode.val.bpp = 8
            pPixel ptr<u8> <- {it.aBackPageBuffer + offset}
            pixel u8
            pixel <- pixel | (red & 0b1110_0000)
            pixel <- pixel | ((green & 0b1110_0000) >> 3)
            pixel <- pixel | ((blue & 0b1100_0000) >> 6)
            pPixel.val <- pixel
        // 15/16 bit color
        else if pMode.val.bpp = 15 or pMode.val.bpp = 16
            pPixel ptr<u16> <- {it.aBackPageBuffer + offset}
            pixel u16
            pixel <- pixel | (red.u16 >> (8 - pMetadata.val.redSize)) << pMetadata.val.redPosition
            pixel <- pixel | (green.u16 >> (8 - pMetadata.val.greenSize)) << pMetadata.val.greenPosition
            pixel <- pixel | (blue.u16 >> (8 - pMetadata.val.blueSize)) << pMetadata.val.bluePosition
            pPixel.val <- pixel
        // 24/32 bit color
        else
            pPixel ptr<data<u8>> <- {it.aBackPageBuffer + offset}
            pixel u32
            pixel <- pixel | ((red.u32 >> (8 - pMetadata.val.redSize)) << pMetadata.val.redPosition)
            pixel <- pixel | ((green.u32 >> (8 - pMetadata.val.greenSize)) << pMetadata.val.greenPosition)
            pixel <- pixel | ((blue.u32 >> (8 - pMetadata.val.blueSize)) << pMetadata.val.bluePosition)

            pPixel.val[0] <- ((pixel >> 0) & 0xff).u8
            pPixel.val[1] <- ((pixel >> 8) & 0xff).u8
            pPixel.val[2] <- ((pixel >> 16) & 0xff).u8
            if (pMode.val.bpp = 32): pPixel.val[3] <- ((pixel >> 24) & 0xff).u8
        ;
    ;
;

AdapterVesa::setDisplayStartRaw raw<"m, m, ~{eax}, ~{ebx}, ~{ecx}, ~{edx}, ~{esi}, ~{edi}, ~{memory}">: aFunctionsTable a, displayOffset u32
    mov esi, $0
    mov ax, [esi + 2]
    movzx eax, ax
    add esi, eax

    mov ecx, $1
    mov edx, ecx
    shr edx, 16
    and ecx, 0xffff

    mov eax, 0x4f07
    mov ebx, 0x0000
    call esi
;