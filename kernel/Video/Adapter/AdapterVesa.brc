@module Video

@import BSys
@import B
@import BiosService
@import Memory

VesaInfo blob
    @ signature data<u8, 4>
    @ version u16
    @ oemStringPtr data<u16, 2>
    @ caps data<u8, 4>
    @ videoModePtr data<u16, 2>
    @ memoryBlocksCount u16
    @ reserved data<u8, 492>
;

VesaModeInfo blob
    @ attributes u16
    u8 // windowA
    u8 //windowB
    u16 //granularity
    u16 // windowSize
    u16 // segmentA
    u16 //segmentB
    u32 // winFunPtr
    @ pitch u16
    @ width u16
    @ height u16
    u8 // xChar
    u8 // yChar
    u8 // planes
    @ bpp u8
    u8 // banks
    u8 // memoryModel
    u8 // bankSize
    u8 // imagePages
    u8 // reserved
    @ redSize u8
    @ redPosition u8
    @ greenSize u8
    @ greenPosition u8
    @ blueSize u8
    @ bluePosition u8
    u8 // reserved
    u8 // reserved
    u8 // directColorAttributes
    @ framebufferPtr u32
    u32 // offScreenMemoryOffset
    u16 // offScreenMemorySize
    data<u8, 206> // reserved
;

AdapterVesa::FRAMEBUFFER_ADR a <- 0xe000_0000

AdapterVesa::BUFFER_MODE_DEVICE u32 <- 0x00
AdapterVesa::BUFFER_MODE_RAM u32 <- 0x01

compModes fun: modeA boxed<ptr<blob<Mode>>>, modeB boxed<ptr<blob<Mode>>> -> enum<@B::Array::ComparisonResult>
    widthA u32 <- modeA.ptr<blob<Mode>>.val.width
    heightA u32 <- modeA.ptr<blob<Mode>>.val.height
    bppA u32 <- modeA.ptr<blob<Mode>>.val.bpp

    widthB u32 <- modeB.ptr<blob<Mode>>.val.width
    heightB u32 <- modeB.ptr<blob<Mode>>.val.height
    bppB u32 <- modeB.ptr<blob<Mode>>.val.bpp

    if widthA > widthB: ret {}.enum<@B::Array::ComparisonResult>::Decreasing
    else if widthA < widthB: ret {}.enum<@B::Array::ComparisonResult>::Increasing

    if heightA > heightB: ret {}.enum<@B::Array::ComparisonResult>::Decreasing
    else if heightA < heightB: ret {}.enum<@B::Array::ComparisonResult>::Increasing

    if bppA > bppB: ret {}.enum<@B::Array::ComparisonResult>::Decreasing
    else if bppA < bppB: ret {}.enum<@B::Array::ComparisonResult>::Increasing

    ret {}.enum<@B::Array::ComparisonResult>::Equal
;

@ AdapterVesa blob: Adapter
    memoryBlocksCount u32
    modeIds blob<@B::Array, u16>
    modes blob<@B::Array, ptr<blob<Mode>>>

    aFrontPageBuffer a
    aBackPageBuffer a
    bufferMode u32

    aVesaFunctionsTable a
    
    @ init fun -> bool
        // Get adapter info
        vesaInfo blob_pack<VesaInfo>
        @BiosService::Video::vesaGetInfo(vesaInfo.adr)

        // Verify signature and version
        if vesaInfo.signature[0] != 'V' or vesaInfo.signature[1] != 'E' or vesaInfo.signature[2] != 'S' or vesaInfo.signature[3] != 'A': ret false
        if vesaInfo.version < 0x0200: ret false

        // Number of 64KiB blocks provided for framebuffer
        it.memoryBlocksCount <- vesaInfo.memoryBlocksCount

        // Get list of mode ids
        p_modeIds ptr<data<u16>> <- {vesaInfo.videoModePtr[1] * 0x10 + vesaInfo.videoModePtr[0]}
        rep i u32, p_modeIds.val[i] < 0xffff, i <- i + 1
            it.modeIds.push(p_modeIds.val[i])
        ;

        // Get pointer to vesa functions table
        it.aVesaFunctionsTable <- @BiosService::Video::vesaGetFunctionsTable()

        ret true
    ;

    @ getModes fun -> blob<@B::Array, ptr<blob<Mode>>>
        if it.modes.count > 0: ret it.modes

        // Get details for each of the modes
        rep i u32, i < it.modeIds.count, i <- i + 1
            vesaModeInfo blob_pack<VesaModeInfo>
            @BiosService::Video::vesaGetModeInfo(vesaModeInfo.adr, it.modeIds.at(i).u16)

            // Filter out weird color modes
            if vesaModeInfo.bpp >= 8
                p_mode ptr<blob<Mode>> <- @BSys::memAlloc(blob<Mode>.size).ptr<blob<Mode>>

                p_mode.val.id <- it.modeIds.at(i).u16
                p_mode.val.width <- vesaModeInfo.width
                p_mode.val.height <- vesaModeInfo.height
                p_mode.val.bpp <- vesaModeInfo.bpp
                p_mode.val.pitch <- vesaModeInfo.pitch

                p_metadata ptr<blob<Mode::Metadata::Vesa>> <- @BSys::memAlloc(blob<Mode::Metadata::Vesa>.size).ptr<blob<Mode::Metadata::Vesa>>
                p_mode.val.a_metadata <- p_metadata.vadr
                p_metadata.val.aFramebuffer <- vesaModeInfo.framebufferPtr.a

                p_metadata.val.redSize <- vesaModeInfo.redSize
                p_metadata.val.redPosition <- vesaModeInfo.redPosition

                p_metadata.val.greenSize <- vesaModeInfo.greenSize
                p_metadata.val.greenPosition <- vesaModeInfo.greenPosition

                p_metadata.val.blueSize <- vesaModeInfo.blueSize
                p_metadata.val.bluePosition <- vesaModeInfo.bluePosition

                it.modes.push(p_mode)
            ;
        ;

        it.modes.sort(compModes.ptr)

        ret it.modes
    ;

    @ getSurface fun: p_mode ptr<blob<Mode>> -> ptr<blob<Surface>>
        // Setup surface
        p_surface ptr<blob<Surface>> <- @BSys::memAlloc(blob<Surface>.size).ptr<blob<Surface>>
        p_surface.val.iAdapter <- {it.ptr}
        p_surface.val.pMode <- p_mode

        // Setup adapter
        p_metadata ptr<blob<Mode::Metadata::Vesa>> <- p_mode.val.a_metadata.ptr<blob<Mode::Metadata::Vesa>>
        @BiosService::Video::vesaSetMode(p_mode.val.id)

        // Setup double buffering
        it.aFrontPageBuffer <- AdapterVesa::FRAMEBUFFER_ADR
        pageSize u32 <- p_mode.val.pitch * p_mode.val.height

        // On device double buffering
        if it.aVesaFunctionsTable != 0 and it.memoryBlocksCount >= (pageSize * 2 + 0x10_000 - 1) / 0x10_000
            it.bufferMode <- AdapterVesa::BUFFER_MODE_DEVICE
            it.aBackPageBuffer <- it.aFrontPageBuffer + pageSize
            @Memory::PagingManager::instance.mapMemory(it.aFrontPageBuffer, p_metadata.val.aFramebuffer, pageSize * 2)
        // In RAM double buffering
        else
            it.bufferMode <- AdapterVesa::BUFFER_MODE_RAM
            it.aBackPageBuffer <- @BSys::memAlloc(pageSize)
            @Memory::PagingManager::instance.mapMemory(it.aFrontPageBuffer, p_metadata.val.aFramebuffer, pageSize)
        ;

        // Set palette for RGB332 in case of 8 bit color
        if p_mode.val.bpp = 8
            palette data<u8, 1024>

            rep i u32, i < 256, i <- i + 1
                red u8 <- (i.u8 & 0b1110_0000) >> 5
                green u8 <- (i.u8 & 0b0001_1100) >> 2
                blue u8 <- i.u8 & 0b0000_0011

                // Convert each component into 0..63 range
                palette[i * 4 + 0] <- blue * 21
                palette[i * 4 + 1] <- green * 9
                palette[i * 4 + 2] <- red * 9
            ;

            @BiosService::Video::vesaSetPalette(palette.adr)
        ;

        // Debug
        @BSys::debugPrintSerial("[VIDEO] mode: ")
        @BSys::debugPrintSerial(@B::StringForU32(p_mode.val.width).string)
        @BSys::debugPrintSerial("x")
        @BSys::debugPrintSerial(@B::StringForU32(p_mode.val.height).string)
        @BSys::debugPrintSerial("@")
        @BSys::debugPrintSerial(@B::StringForU32(p_mode.val.bpp).string)
        if it.bufferMode = AdapterVesa::BUFFER_MODE_DEVICE
            @BSys::debugPrintSerial(" HW_DB\n")
        else
            @BSys::debugPrintSerial(" SF_DB\n")
        ;

        ret p_surface
    ;

    @ commit fun: p_mode ptr<blob<Mode>>
        p_metadata ptr<blob<Mode::Metadata::Vesa>> <- p_mode.val.a_metadata.ptr<blob<Mode::Metadata::Vesa>>

        if it.bufferMode = AdapterVesa::BUFFER_MODE_DEVICE
            // get offset to the new front display area
            displayOffset u32
            if it.aBackPageBuffer > it.aFrontPageBuffer
                displayOffset <- p_mode.val.pitch * p_mode.val.height / 4
            ;

            // swap front with back
            temp a <- it.aFrontPageBuffer
            it.aFrontPageBuffer <- it.aBackPageBuffer
            it.aBackPageBuffer <- temp

            // set new front buffer
            AdapterVesa::setDisplayStartRaw(it.aVesaFunctionsTable, displayOffset)
        else
            @BSys::memCopy(it.aBackPageBuffer, it.aFrontPageBuffer, p_mode.val.pitch * p_mode.val.height)
        ;
    ;

    @ clear fun: p_mode ptr<blob<Mode>>, red u8, green u8, blue u8
        rep y u32, y < p_mode.val.height, y <- y + 1
            rep x u32, x < p_mode.val.width, x <- x + 1
                it.drawPixel(p_mode, x, y, red, green, blue)
            ;
        ;
    ;

    @ drawPixel fun: p_mode ptr<blob<Mode>>, x u32, y u32, red u8, green u8, blue u8
        p_metadata ptr<blob<Mode::Metadata::Vesa>> <- p_mode.val.a_metadata.ptr<blob<Mode::Metadata::Vesa>>
        offset u32 <- y * p_mode.val.pitch + (x * ((p_mode.val.bpp + 7) / 8))

        // 8 bit color (RGB332)
        if p_mode.val.bpp = 8
            pPixel ptr<u8> <- {it.aBackPageBuffer + offset}
            pixel u8
            pixel <- pixel | (red & 0b1110_0000)
            pixel <- pixel | ((green & 0b1110_0000) >> 3)
            pixel <- pixel | ((blue & 0b1100_0000) >> 6)
            pPixel.val <- pixel
        // 15/16 bit color
        else if p_mode.val.bpp = 15 or p_mode.val.bpp = 16
            pPixel ptr<u16> <- {it.aBackPageBuffer + offset}
            pixel u16
            pixel <- pixel | (red.u16 >> (8 - p_metadata.val.redSize)) << p_metadata.val.redPosition
            pixel <- pixel | (green.u16 >> (8 - p_metadata.val.greenSize)) << p_metadata.val.greenPosition
            pixel <- pixel | (blue.u16 >> (8 - p_metadata.val.blueSize)) << p_metadata.val.bluePosition
            pPixel.val <- pixel
        // 24/32 bit color
        else
            pPixel ptr<data<u8>> <- {it.aBackPageBuffer + offset}
            pixel u32
            pixel <- pixel | ((red.u32 >> (8 - p_metadata.val.redSize)) << p_metadata.val.redPosition)
            pixel <- pixel | ((green.u32 >> (8 - p_metadata.val.greenSize)) << p_metadata.val.greenPosition)
            pixel <- pixel | ((blue.u32 >> (8 - p_metadata.val.blueSize)) << p_metadata.val.bluePosition)

            pPixel.val[0] <- ((pixel >> 0) & 0xff).u8
            pPixel.val[1] <- ((pixel >> 8) & 0xff).u8
            pPixel.val[2] <- ((pixel >> 16) & 0xff).u8
            if (p_mode.val.bpp = 32): pPixel.val[3] <- ((pixel >> 24) & 0xff).u8
        ;
    ;
;

AdapterVesa::setDisplayStartRaw raw<"m, m, ~{eax}, ~{ebx}, ~{ecx}, ~{edx}, ~{esi}, ~{edi}, ~{memory}">: aFunctionsTable a, displayOffset u32
    mov esi, $0
    mov ax, [esi + 2]
    movzx eax, ax
    add esi, eax

    mov ecx, $1
    mov edx, ecx
    shr edx, 16
    and ecx, 0xffff

    mov eax, 0x4f07
    mov ebx, 0x0000
    call esi
;