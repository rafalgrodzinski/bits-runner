@module Video

@import B
//@import Bus
@import BSys
@import Memory
@import Pci

// PCI
Adapter::Svga2::VENDOR_ID u16 <- 0x15ad
Adapter::Svga2::DEVICE_ID u16 <- 0x0405

Adapter::Svga2::FRAMEBUFFER_ADR a <- 0xe000_0000

// Port offsets
Adapter::Svga2::INDEX_PORT_OFF u16 <- 0x00
Adapter::Svga2::VALUE_PORT_OFF u16 <- 0x01

// Specification
Adapter::Svga2::SPECS_VER u32 <- 0x9000_0002

// Registers
Adapter::Svga2::REG_ID u16 <- 0x00
Adapter::Svga2::REG_ENABLE u16 <- 0x01

Adapter::Svga2::REG_WIDTH u16 <- 0x02
Adapter::Svga2::REG_HEIGHT u16 <- 0x03
Adapter::Svga2::REG_BPP u16 <- 0x07

Adapter::Svga2::REG_FB_START u16 <- 0x0d
Adapter::Svga2::REG_FB_OFFSET u16 <- 0x0e
Adapter::Svga2::REG_FB_SIZE u16 <- 0x10

Adapter::Svga2::REG_FIFO_START u16 <- 0x12
Adapter::Svga2::REG_FIFO_SIZE u16 <- 0x13
Adapter::Svga2::REG_CAPS u16 <- 0x11

@ Adapter::Svga2 blob: Adapter
    portBase u16
    modes blob<@B::Array, ptr<blob<Mode>>>

    @ init fun: p_pciDevice ptr<blob<@Pci::Device>> -> bool
        // Check if device matches
        if p_pciDevice.val.vendorId != Adapter::Svga2::VENDOR_ID or p_pciDevice.val.deviceId != Adapter::Svga2::DEVICE_ID: ret false

        // Enable bus master, memory space, and IO space
        p_pciDevice.val.sendCommand(0b0111)

        // get base port for registers
        it.portBase <- (p_pciDevice.val.bar0 - 1).u16

        // check version
        it.writeReg(Adapter::Svga2::REG_ID, Adapter::Svga2::SPECS_VER)
        if it.readReg(Adapter::Svga2::REG_ID) != Adapter::Svga2::SPECS_VER: ret false

        /*fifoStart u32 <- it.readReg(Adapter::Svga2::REG_FIFO_START)
        fifoSize u32 <- it.readReg(Adapter::Svga2::REG_FIFO_SIZE)
        caps u32 <- it.readReg(Adapter::Svga2::REG_CAPS)*/

        ret true
    ;

    @ getModes fun -> blob<@B::Array, ptr<blob<Mode>>>
        if it.modes.count > 0: ret it.modes

        /*pMode ptr<blob<Mode>> <- @BSys::memAlloc(blob<Mode>.size).ptr<blob<Mode>>
        pMode.val.id <- 0
        pMode.val.width <- 1024
        pMode.val.height <- 768
        pMode.val.bpp <- 32
        modes.push(pMode)*/

        it.modes.push(Mode(0, 1024, 768, 32, 0))
        //it.modes.push(Mode(1, 1024, 768, 32, 0))

        ret it.modes
    ;

    @ getSurface fun: p_mode ptr<blob<Mode>> -> ptr<blob<Surface>>
        // Setup surface
        p_surface ptr<blob<Surface>> <- Surface({it.ptr}, p_mode)

        // Setup adapter
        pMetadata ptr<blob<Mode::Metadata::Svga2>> <- p_mode.val.aMetadata.ptr<blob<Mode::Metadata::Svga2>>

        it.writeReg(Adapter::Svga2::REG_WIDTH, p_mode.val.width)
        it.writeReg(Adapter::Svga2::REG_HEIGHT, p_mode.val.height)
        it.writeReg(Adapter::Svga2::REG_BPP, p_mode.val.bpp)
        it.writeReg(Adapter::Svga2::REG_ENABLE, 1)

        fbStart u32 <- it.readReg(Adapter::Svga2::REG_FB_START)
        fbOffset u32 <- it.readReg(Adapter::Svga2::REG_FB_OFFSET)
        fbSize u32 <- it.readReg(Adapter::Svga2::REG_FB_SIZE)
        pMetadata.val.aFramebuffer <- Adapter::Svga2::FRAMEBUFFER_ADR // (fbStart + fbOffset).a
        //@Memory::PagingManager::instance.mapDirectMemory(fbStart.a, fbSize)
        @Memory::PagingManager::instance.mapMemory(pMetadata.val.aFramebuffer, fbStart, fbSize)

        ret p_surface
    ;

    @ commit fun: pMode ptr<blob<Mode>>
    ;

    @ clear fun: pMode ptr<blob<Mode>>, red u8, green u8, blue u8
    ;

    @ drawPixel fun: p_mode ptr<blob<Mode>>, x u32, y u32, red u8, green u8, blue u8
        p_metadata ptr<blob<Mode::Metadata::Svga2>> <- p_mode.val.aMetadata.ptr<blob<Mode::Metadata::Svga2>>
        pitch u32 <- (p_mode.val.bpp / 8) * p_mode.val.width
        offset u32 <- y * pitch + (x * (p_mode.val.bpp / 8))

        // 24 bit color
        if p_mode.val.bpp = 24 or p_mode.val.bpp = 32
            p_pixel ptr<data<u8>> <- {p_metadata.val.aFramebuffer + offset}
            p_pixel.val[2] <- red
            p_pixel.val[1] <- green
            p_pixel.val[0] <- blue
        ;
    ;

    readReg fun: reg u16 -> u32
        @BSys::out32(it.portBase + Adapter::Svga2::INDEX_PORT_OFF, reg)
        ret @BSys::in32(it.portBase + Adapter::Svga2::VALUE_PORT_OFF)
    ;

    writeReg fun: reg u16, value u32
        @BSys::out32(it.portBase + Adapter::Svga2::INDEX_PORT_OFF, reg)
        @BSys::out32(it.portBase + Adapter::Svga2::VALUE_PORT_OFF, value)
    ;
;