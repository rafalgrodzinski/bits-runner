@module Video

@import Bus

@export instance blob<Video>

@export Video blob
    primaryAdapter proto<Adapter>

    adapterSvga2 blob<AdapterSvga2>
    adapterVesa blob<AdapterVesa>
    adapterVga blob<AdapterVga>
    adapterNone blob<AdapterNone>

    init fun
        if it.adapterVesa.init()
            it.primaryAdapter <- {it.adapterVesa.ptr}
        else if it.adapterVga.init()
            it.primaryAdapter <- {it.adapterVga.ptr}
        else
            it.primaryAdapter <- {it.adapterNone.ptr}
        ;
    ;
;