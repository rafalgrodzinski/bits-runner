@module Video

@export MODE_RES_320x240 u32 <- 0x0140_00f0
@export MODE_RES_640x480 u32 <- 0x0280_01e0
@export MODE_RES_800x600 u32 <- 0x0320_0258

@export MODE_BPP_4 u32 <- 0x04
@export MODE_BPP_8 u32 <- 0x08
@export MODE_BPP_16 u32 <- 0x10
@export MODE_BPP_32 u32 <- 0x20

@export instance blob<Video>

@export Video blob
    primaryAdapter proto<Adapter>
    adapterVga blob<AdapterVga>
    adapterVesa blob<AdapterVesa>

    init fun
        it.primaryAdapter <- {it.adapterVga.ptr}
        //it.primaryAdapter <- {it.adapterVesa.ptr}
    ;
;