@module BSys

@import Devices

@ debugDumpCpuState raw
    int 0x31
;

@ debugDumpPaging raw<"~{eax}">
    mov eax, 0x00
    int 0x32
;

@ debugDumpStack raw<"m, ~{eax}, ~{ebx}">: size u32
    mov eax, 0x01
    mov ebx, $0
    int 0x32
;

@ debugDumpMemory raw<"m, m, ~{eax}, ~{ebx}, ~{ecx}">: aMem u32, size u32
    mov eax, 0x02
    mov ebx, $0
    mov ecx, $1
    int 0x32
;

@ debugPause fun: scanCode u8
    rep @BiosService::Input::keyboardGetScanCodeWaiting() != scanCode:
;

@ debugPrintSerial fun: characters data<u8, 64>
    rep i u32, characters[i] != 0 and i < 64, i <- i + 1
        @Devices::Serial::instance.write(characters[i])
    ;
;