@module BSys

@import Memory
@import Term
@import BiosService
@import Storage

// Memory
@ memAllocAligned fun: size u32, shouldClear bool, alignment u32 -> a
    ret @Memory::HeapManager::instance.allocAligned({0}, size, shouldClear, alignment)
;

@ memAlloc fun: size u32 -> a
    ret memAllocAligned(size, false, 0)
;

@ memFree fun: adr a
    @Memory::HeapManager::instance.free(adr)
;

@ memCopy raw<"r, r, r, ~{esi}, ~{edi}, ~{ecx}, ~{memory}">: /*$0*/aSource a, /*$1*/aTarget a, /*$2*/size u32
    mov esi, $0
    mov edi, $1
    mov ecx, $2
    cld
    rep movsb
;

@ memSet raw<"r, r, r, ~{eax}, ~{edi}, ~{ecx}, ~{memory}">: /*$0*/value u8, /*$1*/aTarget a, /*$2*/size u32
    mov al, $0
    mov edi, $1
    mov ecx, $2
    cld
    rep stosb
;

// Print
printAttribute u8 <- 0x07

@ printChar fun: character u8
    @Term::printCharacter(character, printAttribute)
;

@ setPrintAttribute fun: attribute u8
    printAttribute <- attribute
;

@ resetPrintAttribute fun
    printAttribute <- 0x07
;

// FsNode, File, Dir
@ fileOpen fun: a_path a -> u64
    ret @Storage::instance.bootFilesystem.getEntry(a_path.ptr<blob<@B::String>>.val).vadr.u64
;

@ fileCreate fun: a_path a -> u64
    a_fsNode a <- @Storage::instance.bootFilesystem.getEntry(a_path.ptr<blob<@B::String>>.val).vadr
    if a_fsNode = 0
        a_fsNode <- @Storage::instance.bootFilesystem.createEntry(a_path.ptr<blob<@B::String>>.val, @Storage::Entry::Kind::FILE).vadr
    ;
    ret a_fsNode.u64
;

@ fileClose fun: resId u64
    memFree(resId.a)
;

@ fileGetSize fun: resId u64 -> u64
    ret resId.a.ptr<blob<@Storage::Entry>>.val.fileSize
;

@ fileRead fun: resId u64, offset u64, size u64, a_target a -> u64
    ret resId.a.ptr<blob<@Storage::Entry>>.val.read(offset.u32, size.u32, a_target)
;

@ fileWrite fun: resId u64, offset u64, size u64, a_source a -> u64
    ret resId.a.ptr<blob<@Storage::Entry>>.val.write(offset.u32, size.u32, a_source)
;

@ fileDelete fun: resId u64 -> bool
    resId.a.ptr<blob<@Storage::Entry>>.val.delete()
    ret true
;

@ dirOpen fun: a_path a -> u64
    ret 0
;

@ dirCreate fun: a_path a -> u64
    ret 0
;

@ dirClose fun: resId u64
;

@ dirDelete fun: resId u64 -> bool
    ret false
;