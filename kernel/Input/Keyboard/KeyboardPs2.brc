@module Input

@export KeyboardPs2 blob: Keyboard
    init fun -> bool
        ret false
        DriverPs2::instance.init()
        ret DriverPs2::instance.isKeyboardPresent
    ;

    getCharacter fun -> u8
        character u8 <- DriverPs2::instance.keyboardBufferedCharacter
        DriverPs2::instance.keyboardBufferedCharacter <- 0
        ret character
    ;
;