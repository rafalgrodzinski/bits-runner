@module Input

@export instance blob<Input>

@export Input blob
    mainKeyboard proto<Keyboard>
    mainMouse proto<Mouse>

    driverNone blob<DriverNone>
    driverPs2 blob<Driver::Ps2>

    init fun
        if it.driverPs2.init()
            it.mainKeyboard <- {it.driverPs2.ptr}
            it.mainMouse <- {it.driverPs2.ptr}
            ret
        ;

        it.mainKeyboard <- {it.driverNone.ptr}
        it.mainMouse <- {it.driverNone.ptr}
    ;
;