@module Input

@ instance blob<Input>

@ Input blob
    @ primaryKeyboard proto<Keyboard>
    @ primaryMouse proto<Mouse>

    keyboardPs2 blob<KeyboardPs2>
    keyboardBios blob<KeyboardBios>
    keyboardNone blob<KeyboardNone>

    mousePs2 blob<MousePs2>
    mouseBios blob<MouseBios>
    mouseNone blob<MouseNone>

    @ init fun
        // Init Keyboard
        if it.keyboardPs2.init()
            it.primaryKeyboard <- {it.keyboardPs2.ptr}
            @BSys::debugPrintSerial("[INPUT] Initialized Keyboard PS/2\n")
        else if it.keyboardBios.init()
            it.primaryKeyboard <- {it.keyboardBios.ptr}
            @BSys::debugPrintSerial("[INPUT] Initialized Keyboard BIOS\n")
        else
            it.primaryKeyboard <- {it.keyboardNone.ptr}
            @BSys::debugPrintSerial("[INPUT] Initialized Keyboard None\n")
        ;

        // Init Mouse
        if it.mousePs2.init()
            it.primaryMouse <- {it.mousePs2.ptr}
            @BSys::debugPrintSerial("[INPUT] Initialized Mouse PS/2\n")
        else if it.mouseBios.init()
            it.primaryMouse <- {it.mouseBios.ptr}
            @BSys::debugPrintSerial("[INPUT] Initialized Mouse BIOS\n")
        else
            it.primaryMouse <- {it.mouseNone.ptr}
            @BSys::debugPrintSerial("[INPUT] Initialized Mouse None\n")
        ;
    ;
;