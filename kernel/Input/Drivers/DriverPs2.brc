@module Input

@import Interrupt
@import B
@import BSys

Driver::Ps2::CMD_PORT u16 <- 0x64
Driver::Ps2::DATA_PORT u16 <- 0x60

Driver::Ps2::KEYBOARD_L_SHIFT u32 <- 0x2a
Driver::Ps2::KEYBOARD_R_SHIFT u32 <- 0x36

Driver::Ps2::KEYBOARD_ASCII_MAP data<u8> <- {
    '\0', // 0x00 unused
    '\0', // 0x01 esc
    '1',  // 0x02
    '2',  // 0x03
    '3',  // 0x04
    '4',  // 0x05
    '5',  // 0x06
    '6',  // 0x07
    '7',  // 0x08
    '8',  // 0x09
    '9',  // 0x0a
    '0',  // 0x0b
    '-',  // 0x0c
    '=',  // 0x0d
    '\b', // 0x0e
    '\t', // 0x0f
    'q',  // 0x10
    'w',  // 0x11
    'e',  // 0x12
    'r',  // 0x13 
    't',  // 0x14
    'y',  // 0x15
    'u',  // 0x16
    'i',  // 0x17
    'o',  // 0x18
    'p',  // 0x19
    '[',  // 0x1a
    ']',  // 0x1b
    '\n', // 0x1c
    '\0', //0x1d L Ctrl
    'a',  // 0x1e
    's',  // 0x1f
    'd',  // 0x20
    'f',  // 0x21
    'g',  // 0x22
    'h',  // 0x23
    'j',  // 0x24
    'k',  // 0x25
    'l',  // 0x26
    ';',  // 0x27
    '\'', // 0x28
    '`',  // 0x29
    '\0', // 0x2a L Shift
    '\\', // 0x2b
    'z',  // 0x2c
    'x',  // 0x2d
    'c',  // 0x2e
    'v',  // 0x2f
    'b',  // 0x30
    'n',  // 0x31
    'm',  // 0x32
    ',',  // 0x33
    '.',  // 0x34
    '/',  // 0x35
    '\0', // 0x36 R shift
    '\0', // 0x37 ?
    '\0', // 0x38 ?
    ' '   // 0x39
}

Driver::Ps2::KEYBOARD_ASCII_MAP_SHIFTED data<u8> <- {
    '\0', // 0x00 unused
    '\0', // 0x01 esc
    '!',  // 0x02
    '@',  // 0x03
    '#',  // 0x04
    '$',  // 0x05
    '%',  // 0x06
    '^',  // 0x07
    '&',  // 0x08
    '*',  // 0x09
    '(',  // 0x0a
    ')',  // 0x0b
    '_',  // 0x0c
    '+',  // 0x0d
    '\b', // 0x0e
    '\t', // 0x0f
    'Q',  // 0x10
    'W',  // 0x11
    'E',  // 0x12
    'R',  // 0x13
    'T',  // 0x14
    'Y',  // 0x15
    'U',  // 0x16
    'I',  // 0x17
    'O',  // 0x18
    'P',  // 0x19
    '{',  // 0x1a
    '}',  // 0x1b
    '\n', // 0x1c
    '\0', // 0x1d L Ctrl
    'A',  // 0x1e
    'S',  // 0x1f
    'D',  // 0x20
    'F',  // 0x21
    'G',  // 0x22
    'H',  // 0x23
    'J',  // 0x24
    'K',  // 0x25
    'L',  // 0x26
    ':',  // 0x27
    '\"',  // 0x28
    '~',  // 0x29
    '\0', // 0x2a L Shift
    '|',  // 0x2b
    'Z',  // 0x2c
    'X',  // 0x2d
    'C',  // 0x2e
    'V',  // 0x2f
    'B',  // 0x30
    'N',  // 0x31
    'M',  // 0x32
    '<',  // 0x33
    '>',  // 0x34
    '?',  // 0x35
    '\0', // 0x36 R shift
    '\0', // 0x37 ?
    '\0', // 0x38 ?
    ' '   // 0x39
}

Driver::Ps2::MOUSE_MODE_STANDARD u8 <- 0x00
Driver::Ps2::MOUSE_MODE_SCROLL_WHEEL u8 <- 0x03
Driver::Ps2::MOUSE_MODE_5_BUTTON u8 <- 0x04

@export Driver::Ps2 blob: Keyboard, Mouse
    // Keyboard
    keyboardStatus data<bool, 128>

    // Mouse
    mouseMode u8
    mouseStatus data<u8, 4>
    currentMouseStatusIndex u32

    mouseIsPressedStates data<bool, 5>
    mouseOffsets data<s32, 3>

    init fun -> bool
        @BSys::disableInterrupts()

        Driver::Ps2::drainDataPort()

        // Reset and check primary
        if Driver::Ps2::writePrimary(0xff) != 0xfa: ret false // 0xfa for ack

        Driver::Ps2::waitForReadReady()
        if @BSys::in8(Driver::Ps2::DATA_PORT) != 0xaa: ret false // 0xaa for success

        // Reset and check secondary
        if Driver::Ps2::writeSecondary(0xff) != 0xfa: ret false // 0xfa for ack

        Driver::Ps2::waitForReadReady()
        if @BSys::in8(Driver::Ps2::DATA_PORT) != 0xaa: ret false // 0xaa for success

        // Enable primary PS/2 port
        Driver::Ps2::waitForWriteReady()
        @BSys::out8(Driver::Ps2::CMD_PORT, 0xae)

        // Enable secondary PS/2 port
        Driver::Ps2::waitForWriteReady()
        @BSys::out8(Driver::Ps2::CMD_PORT, 0xa8)

        // first try enabling scroll wheel mode
        Driver::Ps2::writeSecondary(0xf3)
        Driver::Ps2::writeSecondary(200)
        Driver::Ps2::writeSecondary(0xf3)
        Driver::Ps2::writeSecondary(100)

        Driver::Ps2::writeSecondary(0xf3)
        Driver::Ps2::writeSecondary(80)

        Driver::Ps2::writeSecondary(0xf2)
        Driver::Ps2::waitForReadReady()
        it.mouseMode <- @BSys::in8(Driver::Ps2::DATA_PORT)

        // if succeeded, try enableing 5-button mode
        if it.mouseMode = Driver::Ps2::MOUSE_MODE_SCROLL_WHEEL
            Driver::Ps2::writeSecondary(0xf3)
            Driver::Ps2::writeSecondary(200)

            Driver::Ps2::writeSecondary(0xf3)
            Driver::Ps2::writeSecondary(200)

            Driver::Ps2::writeSecondary(0xf3)
            Driver::Ps2::writeSecondary(80)

            Driver::Ps2::writeSecondary(0xf2)
            Driver::Ps2::waitForReadReady()
            it.mouseMode <- @BSys::in8(Driver::Ps2::DATA_PORT)    
        ;

        // Enable interrupts
        Driver::Ps2::waitForWriteReady()
        @BSys::out8(Driver::Ps2::CMD_PORT, 0x20)

        Driver::Ps2::waitForReadReady()
        status u8 <- @BSys::in8(Driver::Ps2::DATA_PORT)

        status <- status | 0b0000_0001 // enable IRQ 1
        status <- status & 0b1110_1111 // enable primary port clock
        status <- status | 0b0100_0000 // enable primary port translation

        status <- status | 0b0000_0010 // enable IRQ 12
        status <- status & 0b1101_1111 // enable secondary port clock

        Driver::Ps2::waitForWriteReady()
        @BSys::out8(Driver::Ps2::CMD_PORT, 0x60)

        Driver::Ps2::waitForWriteReady()
        @BSys::out8(Driver::Ps2::DATA_PORT, status)

        // Enable data reporting
        Driver::Ps2::writePrimary(0xf4)
        Driver::Ps2::writeSecondary(0xf4)

        // Register keyboard & pointer IRQ handlers
        @Interrupt::Handler::instance.registerIrqCallback(1, Driver::Ps2::irqCallback.ptr)
        @Interrupt::Handler::instance.registerIrqCallback(12, Driver::Ps2::irqCallback.ptr)

        @BSys::enableInterrupts()

        ret true
    ;

    handleInterrupt fun
        // Check if there is data in the output buffer
        rep status u8 <- @BSys::in8(Driver::Ps2::CMD_PORT), status &? 0b0000_0001, status <- @BSys::in8(Driver::Ps2::CMD_PORT)
            // Data from secondary port?
            if (status &? 0b0010_0000)
                it.handleMouseInterrupt()
            // Data from primary port?
            else
                it.handleKeyboardInterrupt()
            ;
        ;
    ;

    handleKeyboardInterrupt fun
        scanCode u8 <- @BSys::in8(Driver::Ps2::DATA_PORT)

        isPressed bool <- scanCode & 0x80 = 0
        scanCode <- scanCode & 0x7f // get rid of the flag

        // ignore if there is not status update (eg, repeated key)
        if it.keyboardStatus[scanCode] = isPressed: ret

        it.keyboardStatus[scanCode] <- isPressed

        // Translate into ASCII
        ascii u8

        // check range
        if scanCode < Driver::Ps2::KEYBOARD_ASCII_MAP.count and isPressed
            isShiftPressed bool <- it.keyboardStatus[Driver::Ps2::KEYBOARD_L_SHIFT] or it.keyboardStatus[Driver::Ps2::KEYBOARD_R_SHIFT]
            ascii <- if isShiftPressed: Driver::Ps2::KEYBOARD_ASCII_MAP_SHIFTED[scanCode] else: Driver::Ps2::KEYBOARD_ASCII_MAP[scanCode]
        ;

        @B::StringForChar(ascii).print()
    ;

    handleMouseInterrupt fun
        // store received data in current slot
        it.mouseStatus[it.currentMouseStatusIndex] <- @BSys::in8(Driver::Ps2::DATA_PORT)

        it.currentMouseStatusIndex <- it.currentMouseStatusIndex + 1
        if it.mouseMode = Driver::Ps2::MOUSE_MODE_STANDARD and it.currentMouseStatusIndex < 3: ret
        if (it.mouseMode = Driver::Ps2::MOUSE_MODE_SCROLL_WHEEL or it.mouseMode = Driver::Ps2::MOUSE_MODE_5_BUTTON) and it.currentMouseStatusIndex < 4: ret

        // received all the required data bytes, reset the counter
        it.currentMouseStatusIndex <- 0

        // get standard pressed buttons
        it.mouseIsPressedStates[0] <- it.mouseStatus[0] &? 0b0000_0001
        it.mouseIsPressedStates[1] <- it.mouseStatus[0] &? 0b0000_0010
        it.mouseIsPressedStates[2] <- it.mouseStatus[0] &? 0b0000_0100

        // get extended pressed buttons
        if it.mouseMode = Driver::Ps2::MOUSE_MODE_5_BUTTON
            it.mouseIsPressedStates[3] <- it.mouseStatus[3] &? 0b0001_0000
            it.mouseIsPressedStates[4] <- it.mouseStatus[3] &? 0b0010_0000
        ;

        // decode X delta
        it.mouseOffsets[0] <- it.mouseStatus[1]
        if it.mouseStatus[0] &? 0b0001_0000
            it.mouseOffsets[0] <- it.mouseOffsets[0] | 0xffff_ff00
        ;

        // decode Y delta
        it.mouseOffsets[1] <- it.mouseStatus[2]
        if it.mouseStatus[0] &? 0b0010_0000
            it.mouseOffsets[1] <- it.mouseOffsets[1] | 0xffff_ff00
        ;

        // decode scroll wheel delta
        if it.mouseMode = Driver::Ps2::MOUSE_MODE_SCROLL_WHEEL
            it.mouseOffsets[2] <- it.mouseStatus[3] & 0b0111_1111
            if it.mouseStatus[3] &? 0b1000_0000
                it.mouseOffsets[2] <- it.mouseOffsets[2] | 0xffff_ff80
            ;
        else if it.mouseMode = Driver::Ps2::MOUSE_MODE_5_BUTTON
            it.mouseOffsets[2] <- it.mouseStatus[3] & 0b0000_0111
            if it.mouseStatus[3] &? 0b0000_1000
                it.mouseOffsets[2] <- it.mouseOffsets[2] | 0xffff_fff8
            ;
        ;

        rep i u32, i < 5, i <- i + 1
            if it.mouseIsPressedStates[i]: @B::String("T ").print() else: @B::String("F ").print()
        ;

        rep i u32, i < 3, i <- i + 1
            @B::StringForS32(it.mouseOffsets[i]).print()
            @B::String(" ").print()
        ;
        @B::String("").println()
    ;
;

Driver::Ps2::irqCallback fun
    instance.driverPs2.handleInterrupt()
;

Driver::Ps2::waitForReadReady fun
    rep count u32, count < 100_000 and not @BSys::in8(Driver::Ps2::CMD_PORT) &? 0b0000_0001, count <- count + 1:
;

Driver::Ps2::waitForWriteReady fun
    rep count u32, count < 100_000 and @BSys::in8(Driver::Ps2::CMD_PORT) &? 0b0000_0010, count <- count + 1:
;

Driver::Ps2::drainDataPort fun
    rep @BSys::in8(Driver::Ps2::CMD_PORT) &? 0b0000_0001: @BSys::in8(Driver::Ps2::DATA_PORT)
;

Driver::Ps2::writePrimary fun: value u8 -> u8
    Driver::Ps2::waitForWriteReady()
    @BSys::out8(Driver::Ps2::DATA_PORT, value)

    Driver::Ps2::waitForReadReady()
    ret @BSys::in8(Driver::Ps2::DATA_PORT) // get ACK 0xfa
;

Driver::Ps2::writeSecondary fun: value u8 -> u8
    Driver::Ps2::waitForWriteReady()
    @BSys::out8(Driver::Ps2::CMD_PORT, 0xd4) // Select secondary PS/2 port

    Driver::Ps2::waitForWriteReady()
    @BSys::out8(Driver::Ps2::DATA_PORT, value)

    Driver::Ps2::waitForReadReady()
    ret @BSys::in8(Driver::Ps2::DATA_PORT) // get ACK 0xfa
;