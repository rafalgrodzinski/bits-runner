@module Interrupt

@import Memory

HandlerDebug::DUMP_PAGING u32 <- 0x00
HandlerDebug::DUMP_STACK u32 <- 0x01
HandlerDebug::DUMP_MEMORY u32 <- 0x02

@export HandlerDebug blob
    handle fun: pCpuState ptr<blob<CpuState>>, interrupt u32, errorCode u32
        if interrupt = Int::DEBUG_DUMP_CPU_STATE
            it.dumpCpuState(pCpuState)
        else if pCpuState.val.eax = HandlerDebug::DUMP_STACK
            it.dumpStack(pCpuState.val.esp.a, pCpuState.val.ebx)
        else if pCpuState.val.eax = HandlerDebug::DUMP_PAGING
            it.dumpPaging()
        else if pCpuState.val.eax = HandlerDebug::DUMP_MEMORY
            it.dumpMemory(pCpuState.val.ebx.a, pCpuState.val.ecx)
        ;
    ;

    dumpCpuState fun: pCpuState ptr<blob<CpuState>>
        @B::String("eax: ").print()
        @B::StringHexForU32(pCpuState.val.eax).print()
        @B::String(", ebx: ").print()
        @B::StringHexForU32(pCpuState.val.ebx).print()
        @B::String(", ecx: ").print()
        @B::StringHexForU32(pCpuState.val.ecx).print()
        @B::String(", edx: ").print()
        @B::StringHexForU32(pCpuState.val.edx).println()

        @B::String("esi: ").print()
        @B::StringHexForU32(pCpuState.val.esi).print()
        @B::String(", edi: ").print()
        @B::StringHexForU32(pCpuState.val.edi).print()
        @B::String(", ebp: ").print()
        @B::StringHexForU32(pCpuState.val.ebp).print()
        @B::String(", esp: ").print()
        @B::StringHexForU32(pCpuState.val.esp).println()

        @B::String("cs: ").print()
        @B::StringHexForU32(pCpuState.val.cs).print()
        @B::String(", ds: ").print()
        @B::StringHexForU32(pCpuState.val.ds).print()
        @B::String(", es: ").print()
        @B::StringHexForU32(pCpuState.val.es).print()
        @B::String(", fs: ").print()
        @B::StringHexForU32(pCpuState.val.fs).print()
        @B::String(", gs: ").print()
        @B::StringHexForU32(pCpuState.val.gs).print()
        @B::String(", ss: ").print()
        @B::StringHexForU32(pCpuState.val.ss).println()

        @B::String("eip: ").print()
        @B::StringHexForU32(pCpuState.val.eip).print()
        @B::String(", eflags: ").print()
        @B::StringHexForU32(pCpuState.val.eflags).println()

        @B::String("cr0: ").print()
        @B::StringHexForU32(@BSys::getCr0()).print()
        @B::String(", cr3: ").print()
        @B::StringHexForU32(@BSys::getCr3()).println()
    ;

    dumpStack fun: aStack a, size u32
        aStack <- aStack & 0xffff_fffc // align-down to 4 byte boundary

        rep i u32, i < size, i <- i + u32.size
            @B::StringHexForU32(aStack.u32 + i).print()
            @B::String(": ").print()
            @B::StringHexForU32({aStack + i}.ptr<u32>.val).println()
        ;
    ;

    dumpPaging fun
        pPageTablesDirectory ptr<data<u32>> <- {@Memory::PagingManager::PAGE_TABLES_DIRECTORY_ADR}
        rep iTable u32, iTable < 1024, iTable <- iTable + 1
            if pPageTablesDirectory.val[iTable] != 0
                // Index
                @B::StringForU32(iTable).print()
                // Linear range
                @B::String(": L").print()
                @B::StringHexForU32(iTable * 1024 * 4096).print()
                @B::String(" - L").print()
                @B::StringHexForU32((iTable + 1) * 1024 * 4096 - 1).print()
                // Physical stored location
                @B::String(" @ P").print()
                @B::StringHexForU32(pPageTablesDirectory.val[iTable] & 0xffff_f000).print()
                // Flags
                @B::String(":").print()
                if pPageTablesDirectory.val[iTable] &? 0b001: @B::String(" P").print()
                if pPageTablesDirectory.val[iTable] &? 0b010: @B::String(" RW").print()
                if pPageTablesDirectory.val[iTable] &? 0b100: @B::String(" U").print()

                @B::String("").println()

                pPagesTable ptr<data<u32>> <- {@Memory::PagingManager::PAGE_TABLES_ADR + iTable * @Memory::PagingManager::PAGES_TABLE_SIZE}
                rep iPage u32, iPage < 1024, iPage <- iPage + 1
                    if pPagesTable.val[iPage] != 0
                        // Index
                        @B::String("  ").print()
                        @B::StringForU32(iPage).print()
                        // Linear range
                        @B::String(": L").print()
                        @B::StringHexForU32(iTable * 1024 * 4096 + iPage * 4096).print()
                        @B::String(" - L").print()
                        @B::StringHexForU32(iTable * 1024 * 4096 + (iPage + 1) * 4096 - 1).print()
                        // Physical range
                        @B::String(" to P").print()
                        @B::StringHexForU32(pPagesTable.val[iPage] & 0xffff_f000).print()
                        @B::String(" - P").print()
                        @B::StringHexForU32((pPagesTable.val[iPage] & 0xffff_f000) + 4096 - 1).print()
                        // Flags
                        @B::String(":").print()
                        if pPagesTable.val[iPage] &? 0b001: @B::String(" P").print()
                        if pPagesTable.val[iPage] &? 0b010: @B::String(" RW").print()
                        if pPagesTable.val[iPage] &? 0b100: @B::String(" U").print()

                        @B::String("").println()
                    ;
                ;
            ;
        ;
    ;

    dumpMemory fun: aMem a, size u32
        pMem ptr<data<u8>> <- aMem.ptr<data<u8>>

        rep i u32, i < size, i <- i + 1
            if i > 0 and i % 16 = 0: @B::String("").println()
            @B::StringHexForU32(pMem.val[i]).print()
            @B::String(" ").print()
        ;
        @B::String("").println()
    ;
;