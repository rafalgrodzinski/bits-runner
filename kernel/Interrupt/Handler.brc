@module Interrupt

@import B
@import BSys
@import Term
@import DeviceKeyboard
@import DeviceMouse
@import Devices

@extern interrupt_handler_init fun

INT_PAGE_FAULT u32 <- 0x0e
INT_IRQ0 u32 <- 0x20 // timer
INT_IRQ1 u32 <- 0x21 // keyboard
INT_IRQ12 u32 <- 0x2c // mouse
INT_SYSCALL u32 <- 0x30
INT_DEBUG_DUMP_CPU_STATE u32 <- 0x31
INT_DEBUG_DUMP_STACK u32 <- 0x32

deviceKeyboard blob<@DeviceKeyboard::DeviceKeyboard>
deviceMouse blob<@DeviceMouse::DeviceMouse>

@export CpuState blob
    ss u16
    u16 // stack alignment
    esp u32

    gs u16
    u16 // stack alignment
    fs u16
    u16 // stack alignment
    es u16
    u16 // stack alignment
    ds u16
    u16 // stack alignment

    edi u32
    esi u32
    ebp u32
    u32 // esp0
    ebx u32
    edx u32
    ecx u32
    eax u32

    u32 // interrupt
    u32 // errorCode

    eip u32
    cs u32
    eflags u32
;

@export Handler::instance blob<Handler>

@export Handler blob
    init fun
        interrupt_handler_init()
        deviceKeyboard.init()
        deviceMouse.init()
    ;

    handle fun: pCpuState ptr<blob<CpuState>>, interrupt u32, errorCode u32 -> u32
        // Page fault
        if interrupt = INT_PAGE_FAULT
            @Term::printString("Page fault accessing memory at: ", @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printHex(@BSys::getCr2(), @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printNewLine()
            rep: @BSys::halt()
        // Timer
        else if interrupt = INT_IRQ0
            @Devices::Timer::Pit::instance.handleInterrupt()
        // Keyboard
        else if interrupt = INT_IRQ1
            deviceKeyboard.handleInterrupt()
        // Mouse
        else if interrupt = INT_IRQ12
            deviceMouse.handleInterrupt()
        // Syscall
        else if interrupt = INT_SYSCALL
            ret SyscallHandler::instance.handle(
                pCpuState.val.eax,
                pCpuState.val.ebx,
                pCpuState.val.ecx,
                pCpuState.val.edx,
                pCpuState.val.esi
            )
        // Debug
        else if interrupt = INT_DEBUG_DUMP_CPU_STATE
            it.debugDumpCpuState(pCpuState)
        else if interrupt = INT_DEBUG_DUMP_STACK
            it.debugDumpStack(pCpuState.val.esp.a, pCpuState.val.eax)
        // Other
        else
            @Term::printString("Unhandled interrupt: ", @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printHex(interrupt, @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printString(", error code: ", @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printHex(errorCode, @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printNewLine()
            rep: @BSys::halt()
        ;

        ret pCpuState.val.eax
    ;

    debugDumpCpuState fun: pCpuState ptr<blob<CpuState>>
        @B::String("eax: ").print()
        @B::StringHexForU32(pCpuState.val.eax).print()
        @B::String(", ebx: ").print()
        @B::StringHexForU32(pCpuState.val.ebx).print()
        @B::String(", ecx: ").print()
        @B::StringHexForU32(pCpuState.val.ecx).print()
        @B::String(", edx: ").print()
        @B::StringHexForU32(pCpuState.val.edx).println()

        @B::String("esi: ").print()
        @B::StringHexForU32(pCpuState.val.esi).print()
        @B::String(", edi: ").print()
        @B::StringHexForU32(pCpuState.val.edi).print()
        @B::String(", ebp: ").print()
        @B::StringHexForU32(pCpuState.val.ebp).print()
        @B::String(", esp: ").print()
        @B::StringHexForU32(pCpuState.val.esp).println()

        @B::String("cs: ").print()
        @B::StringHexForU32(pCpuState.val.cs).print()
        @B::String(", ds: ").print()
        @B::StringHexForU32(pCpuState.val.ds).print()
        @B::String(", es: ").print()
        @B::StringHexForU32(pCpuState.val.es).print()
        @B::String(", fs: ").print()
        @B::StringHexForU32(pCpuState.val.fs).print()
        @B::String(", gs: ").print()
        @B::StringHexForU32(pCpuState.val.gs).print()
        @B::String(", ss: ").print()
        @B::StringHexForU32(pCpuState.val.ss).println()

        @B::String("eip: ").print()
        @B::StringHexForU32(pCpuState.val.eip).print()
        @B::String(", eflags: ").print()
        @B::StringHexForU32(pCpuState.val.eflags).println()

        @B::String("cr0: ").print()
        @B::StringHexForU32(@BSys::getCr0()).print()
        @B::String(", cr3: ").print()
        @B::StringHexForU32(@BSys::getCr3()).println()
    ;

    debugDumpStack fun: aStack a, size u32
        aStack <- aStack & 0xffff_fffc // align-down to 4 byte boundary

        rep i u32, i < size, i <- i + u32.size
            @B::StringHexForU32(aStack.u32 + i).print()
            @B::String(": ").print()
            @B::StringHexForU32({aStack + i}.ptr<u32>.val).println()
        ;
    ;
;

@export handleInterrupt fun: pCpuState ptr<blob<CpuState>>, interrupt u32, errorCode u32 -> u32
    ret Handler::instance.handle(pCpuState, interrupt, errorCode)
;