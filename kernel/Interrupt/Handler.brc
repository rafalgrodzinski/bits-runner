@module Interrupt

@import B
@import BSys
@import Term
@import Devices

@extern interrupt_handler_init fun

Handler::PIC1_DATA_PORT u16 <- 0x21
Handler::PIC2_DATA_PORT u16 <- 0xa1

Handler::INT_PAGE_FAULT u32 <- 0x0e
Handler::INT_IRQ0 u32 <- 0x20
Handler::INT_SYSCALL u32 <- 0x30
Handler::INT_DEBUG_DUMP_CPU_STATE u32 <- 0x31
Handler::INT_DEBUG_CALL u32 <- 0x32

@export CpuState blob
    ss u16
    u16 // stack alignment
    esp u32

    gs u16
    u16 // stack alignment
    fs u16
    u16 // stack alignment
    es u16
    u16 // stack alignment
    ds u16
    u16 // stack alignment

    edi u32
    esi u32
    ebp u32
    u32 // esp0
    ebx u32
    edx u32
    ecx u32
    eax u32

    u32 // interrupt
    u32 // errorCode

    eip u32
    cs u32
    eflags u32
;

@export Handler::instance blob<Handler>

@export Handler blob
    handlerSyscall blob<HandlerSyscall>
    handlerDebug blob<HandlerDebug>

    irqCallbacks data<ptr<fun>, 16>

    init fun
        interrupt_handler_init()
    ;

    handle fun: pCpuState ptr<blob<CpuState>>, interrupt u32, errorCode u32 -> u32
        // Page fault
        if interrupt = Handler::INT_PAGE_FAULT
            @Term::printString("Page fault accessing memory at: ", @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printHex(@BSys::getCr2(), @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printNewLine()
            rep: @BSys::halt()
        // IRQs
        else if interrupt >= Handler::INT_IRQ0 and interrupt < Handler::INT_IRQ0 + 16
            irq u32 <- interrupt - Handler::INT_IRQ0
            if it.irqCallbacks[irq].vadr != 0: it.irqCallbacks[irq].val()
        // Syscall
        else if interrupt = Handler::INT_SYSCALL
            ret it.handlerSyscall.handle(
                pCpuState.val.eax,
                pCpuState.val.ebx,
                pCpuState.val.ecx,
                pCpuState.val.edx,
                pCpuState.val.esi
            )
        // Debug
        else if interrupt = Handler::INT_DEBUG_DUMP_CPU_STATE or interrupt = Handler::INT_DEBUG_CALL
            it.handlerDebug.handle(pCpuState, interrupt, errorCode)
        // Other
        else
            @Term::printString("Unhandled interrupt: ", @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printHex(interrupt, @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printString(", error code: ", @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printHex(errorCode, @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printNewLine()
            rep: @BSys::halt()
        ;

        ret pCpuState.val.eax
    ;

    registerIrqCallback fun: irq u32, callback ptr<fun>
        // ignore cascading IRQ
        if irq >= it.irqCallbacks.count or irq = 2: ret

        // Register callback
        it.irqCallbacks[irq] <- callback

        // Unmask IRQ
        port u16 <- if irq < 8
            Handler::PIC1_DATA_PORT
        else
            irq <- irq - 8
            Handler::PIC2_DATA_PORT
        ;

        mask u8 <- @BSys::in8(port)
        mask <- mask & ~(1 << irq)

        @BSys::out8(port, mask)
    ;
;

@export handleInterrupt fun: pCpuState ptr<blob<CpuState>>, interrupt u32, errorCode u32 -> u32
    ret Handler::instance.handle(pCpuState, interrupt, errorCode)
;