@module Interrupt

@import B
@import BSys
@import Term
@import DeviceKeyboard
@import DeviceMouse
@import Devices

@extern interrupt_handler_init fun

INT_PAGE_FAULT u32 <- 0x0e
INT_IRQ0 u32 <- 0x20 // timer
INT_IRQ1 u32 <- 0x21 // keyboard
INT_IRQ12 u32 <- 0x2c // mouse
INT_SYSCALL u32 <- 0x30
INT_DEBUG_DUMP u32 <- 0x31

deviceKeyboard blob<@DeviceKeyboard::DeviceKeyboard>
deviceMouse blob<@DeviceMouse::DeviceMouse>

@export Handler::instance blob<Handler>

@export Handler blob
    init fun
        interrupt_handler_init()
        deviceKeyboard.init()
        deviceMouse.init()
    ;

    handle fun: eax u32, ebx u32, ecx u32, edx u32, esi u32, edi u32, ebp u32, esp u32, eip u32, eflags u32, cs u16, ds u16, es u16, fs u16, gs u16, ss u16, interrupt u32, errorCode u32 -> u32
        // Page fault
        if interrupt = INT_PAGE_FAULT
            @Term::printString("Page fault accessing memory at: ", @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printHex(@BSys::getCr2(), @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printNewLine()
            rep: @BSys::halt()
        // Timer
        else if interrupt = INT_IRQ0
            @Devices::Timer::Pit::instance.handleInterrupt()
        // Keyboard
        else if interrupt = INT_IRQ1
            deviceKeyboard.handleInterrupt()
        // Mouse
        else if interrupt = INT_IRQ12
            deviceMouse.handleInterrupt()
        // Syscall
        else if interrupt = INT_SYSCALL
            ret SyscallHandler::instance.handle(eax, ebx, ecx, edx, esi)
        // Debug
        else if interrupt = INT_DEBUG_DUMP
            it.debugDump(eax, ebx, ecx, edx, esi, edi, ebp, esp, eip, eflags, cs, ds, es, fs, gs, ss)
        // Other
        else
            @Term::printString("Unhandled interrupt: ", @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printHex(interrupt, @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printString(", error code: ", @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printHex(errorCode, @Term::FOREGROUND_RED + @Term::ATTRIB_BLINKING)
            @Term::printNewLine()
            rep: @BSys::halt()
        ;

        ret eax
    ;

    debugDump fun: eax u32, ebx u32, ecx u32, edx u32, esi u32, edi u32, ebp u32, esp u32, eip u32, eflags u32, cs u16, ds u16, es u16, fs u16, gs u16, ss u16
        @B::String("eax: ").print()
        @B::StringHexForU32(eax).print()
        @B::String(", ebx: ").print()
        @B::StringHexForU32(ebx).print()
        @B::String(", ecx: ").print()
        @B::StringHexForU32(ecx).print()
        @B::String(", edx: ").print()
        @B::StringHexForU32(edx).println()

        @B::String("esi: ").print()
        @B::StringHexForU32(esi).print()
        @B::String(", edi: ").print()
        @B::StringHexForU32(edi).print()
        @B::String(", ebp: ").print()
        @B::StringHexForU32(ebp).print()
        @B::String(", esp: ").print()
        @B::StringHexForU32(esp).println()

        @B::String("cs: ").print()
        @B::StringHexForU32(cs).print()
        @B::String(", ds: ").print()
        @B::StringHexForU32(ds).print()
        @B::String(", es: ").print()
        @B::StringHexForU32(es).print()
        @B::String(", fs: ").print()
        @B::StringHexForU32(fs).print()
        @B::String(", gs: ").print()
        @B::StringHexForU32(gs).print()
        @B::String(", ss: ").print()
        @B::StringHexForU32(ss).println()

        @B::String("eip: ").print()
        @B::StringHexForU32(eip).print()
        @B::String(", eflags: ").print()
        @B::StringHexForU32(eflags).println()
    ;
;

@export handleInterrupt fun: eax u32, ebx u32, ecx u32, edx u32, esi u32, edi u32, ebp u32, ss u16, esp u32, cs u16, eip u32, eflags u32, ds u16, es u16, fs u16, gs u16, interrupt u32, errorCode u32 -> u32
    ret Handler::instance.handle(eax, ebx, ecx, edx, esi, edi, ebp, esp, eip, eflags, cs, ds, es, fs, gs, ss, interrupt, errorCode)
;