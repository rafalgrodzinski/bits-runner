@module Pci

@import BSys

@ Device blob
    @ busNum u8
    @ deviceNum u8
    @ funNum u8

    @ vendorId u16
    @ deviceId u16
    @ class u8
    @ subClass u8

    @ bar0 u32
    @ bar1 u32
    @ bar2 u32
    @ bar3 u32
    @ bar4 u32
    @ bar5 u32

    @ sendCommand fun: command u16
        // encode address
        pciAdr u32 <- 0x8000_0000 // <31: enable>
        pciAdr <- pciAdr | (it.busNum << 16) // <23-16: bus number>
        pciAdr <- pciAdr | (it.deviceNum << 11) // <15-11: device number>
        pciAdr <- pciAdr | (it.funNum << 8) // <10-8: function number>
        pciAdr <- pciAdr | 0x04 // <7-0: register offset>

        // read reg1
        @BSys::out32(Port::CONFIG_ADR, pciAdr)
        reg1 u32 <- @BSys::in32(Port::CONFIG_DATA)

        // modify command
        reg1 <- reg1 | command

        // update reg1
        @BSys::out32(Port::CONFIG_ADR, pciAdr)
        @BSys::out32(Port::CONFIG_DATA, reg1)
    ;
;

@ Device fun:
busNum u8,
deviceNum u8,
funNum u8,

vendorId u16,
deviceId u16,
class u8,
subClass u8,

bar0 u32,
bar1 u32,
bar2 u32,
bar3 u32,
bar4 u32,
bar5 u32 -> ptr<blob<Device>>

    p_device ptr<blob<Device>> <- @BSys::memAlloc(blob<Device>.size).ptr<blob<Device>>
    if p_device.vadr = 0: ret {0}

    p_device.val.busNum <- busNum
    p_device.val.deviceNum <- deviceNum
    p_device.val.funNum <- funNum

    p_device.val.vendorId <- vendorId
    p_device.val.deviceId <- deviceId
    p_device.val.class <- class
    p_device.val.subClass <- subClass

    p_device.val.bar0 <- bar0
    p_device.val.bar0 <- bar1
    p_device.val.bar0 <- bar2
    p_device.val.bar0 <- bar3
    p_device.val.bar0 <- bar4
    p_device.val.bar0 <- bar5

    ret p_device
;